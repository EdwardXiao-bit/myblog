# build output
dist/
.astro/

# dependencies
node_modules/

# npm cache（本机沙箱需要把缓存放在工作区内）
.npm-cache/

# 数据库（留言 / 日记都在这，别提交）
data/*.db
data/*.db-*

# 留言上传的图片：运行时数据，不进版本库
# （部署时它和数据库一样需要持久化磁盘）
data/uploads/

# 照片打码：原图备份 + 效果预览，都是本地临时产物
data/originals/
data/preview/

# 备份产物（服务器上由 scripts/backup.mjs 生成，绝不进仓库）
backups/

# 环境变量
.env
.env.production

# 系统垃圾
.DS_Store
Thumbs.db
*.log
