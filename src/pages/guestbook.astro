---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import EmojiPicker from '../components/EmojiPicker.astro';
import ReactionBar from '../components/ReactionBar.astro';
import ReplyList from '../components/ReplyList.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { site } from '../data/site';
import { LIMITS, hashIp, listFeed, moderationOn } from '../lib/guestbook';
import { MAX_IMAGES_PER_ENTRY, MAX_IMAGE_BYTES } from '../lib/storage';
import { formatDateTime } from '../utils/format';
import { isImpostor } from '../utils/nickname';

// 拿到访问者的 IP 哈希，用来判断「我点过赞没有」。拿不到就退化得不显示已赞状态。
let ipHash: string | null = null;
try {
  ipHash = hashIp(Astro.clientAddress ?? 'unknown');
} catch {
  ipHash = null;
}

// 留言板本身没有图：把最近三场活动的照片借来当导航，也让这页不是纯表单
const recent = (await getCollection('activities'))
  .filter((a) => a.data.cover)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);

const entries = listFeed(LIMITS.feed, ipHash);
const moderated = moderationOn();

const maxImages = MAX_IMAGES_PER_ENTRY;
const maxImageMb = Math.round(MAX_IMAGE_BYTES / 1024 / 1024);

const notices: Record<string, { tone: 'ok' | 'warn'; text: string }> = {
  ok: { tone: 'ok', text: '收到，谢谢。' },
  pending: { tone: 'ok', text: '留言收到了。审核通过后才会公开显示。' },
  rate: { tone: 'warn', text: `提交有点频繁，同一来源一小时最多 ${LIMITS.perHour} 条，稍后再试。` },
  empty: { tone: 'warn', text: '写点什么，或者选一张图片。' },
  'too-long': { tone: 'warn', text: `内容最多 ${LIMITS.body} 字，精简一下再发。` },
  'too-many-images': { tone: 'warn', text: `最多只能带 ${maxImages} 张图片。` },
  'image-too-large': { tone: 'warn', text: `单张图片不能超过 ${maxImageMb} MB。` },
  'bad-image': { tone: 'warn', text: '图片格式不支持，请用 jpg / png / webp / gif。' },
  'bad-request': { tone: 'warn', text: '请求来源校验没通过，已拒绝。' },
};

const code = Astro.url.searchParams.get('m') ?? '';
const notice = notices[code];
---

<BaseLayout title={`留言板 · ${site.name}`} description={`给 ${site.name} 留言，可以匿名`}>
  <header class="page-head" data-reveal>
    <h1 data-reveal>留言板</h1>
    <p class="lead" data-reveal>
      想说什么都行：昵称留空就是匿名，填了会署名；也可以只发图片，最多三张，文字和图片都会先审核再显示。
    </p>
  </header>

  {
    notice && (
      <p class={`notice notice-${notice.tone}`} role="status">
        {notice.text}
      </p>
    )
  }

  {
    recent.length > 0 && (
      <section class="recent" aria-label="最近的活动照片">
        <p class="recent-label mono" data-reveal>最近的照片</p>
        <ul class="recent-list">
          {recent.map((item) => (
            <li data-reveal>
              <a href={`/activities/${item.id}`} class="recent-item" data-tilt>
                <span class="recent-shot notched">
                  <Image
                    src={item.data.cover!}
                    alt={item.data.title}
                    widths={[220, 330, 440]}
                    sizes="(max-width: 640px) 33vw, 240px"
                    data-drift
                  />
                </span>
                <span class="recent-title">{item.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
        <a class="link" href="/activities">
          看全部活动 <span class="arrow" aria-hidden="true">↗</span>
        </a>
      </section>
    )
  }

  <section class="write" aria-label="写留言" data-reveal>
    <div class="section-head">
      <h2>写留言</h2>
    </div>

    <form class="gb-form" method="post" action="/api/guestbook" enctype="multipart/form-data">
      <div class="field-row">
        <div class="field" data-reveal>
          <label for="nickname">昵称</label>
          <input
            id="nickname"
            name="nickname"
            type="text"
            maxlength={LIMITS.nickname}
            placeholder="留空即匿名"
            autocomplete="nickname"
            data-owner={site.name}
          />
          {/* 彩蛋：输入站主昵称时冒出来 */}
          <p class="egg" id="nickname-egg" hidden>竟然和我一个昵称！🤡<!-- taste-skill-ignore: 🤡 属于彩蛋文案内容，不是图标替代 --> 那你是冒牌的</p>
        </div>

        <div class="field" data-reveal>
          <label for="images">
            配图（可选，最多 {maxImages} 张，单张不超过 {maxImageMb} MB）
          </label>
          <div class="upload">
            <input
              id="images"
              name="images"
              type="file"
              accept="image/*"
              multiple
              class="sr-only"
              data-max-images={maxImages}
              data-max-mb={maxImageMb}
            />
            <label class="btn btn-ghost upload-pick" for="images">选择图片</label>
            <p class="upload-state" id="file-state" aria-live="polite">未选择图片</p>
          </div>
          <p class="file-note" id="file-note" role="status"></p>
        </div>
      </div>

      <div class="field" data-reveal>
        <label for="body">想说的话</label>
        <textarea
          id="body"
          name="body"
          rows="4"
          maxlength={LIMITS.body}
          placeholder="说点什么吧……"></textarea>

        <div class="editor-bar">
          <EmojiPicker target="body" />
          <span class="counter"><span id="char-count">0</span> / {LIMITS.body}</span>
        </div>
      </div>

      {/* 蜜罐：真人看不见，机器人会填 */}
      <div class="hp" aria-hidden="true">
        <label for="website">网址</label>
        <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <input type="hidden" name="ts" value={Date.now()} />

      <div class="form-foot">
        <p class="hint">{moderated ? '留言会先经过审核再显示' : '提交后立即显示'}</p>
        <button type="submit" class="btn">发送</button>
      </div>
    </form>
  </section>

  <section class="section" aria-label="留言列表" data-reveal>
    <div class="section-head">
      <h2>留言</h2>
      {entries.length > 0 && <span class="count">{entries.length}</span>}
    </div>

    {
      entries.length === 0 ? (
        <p class="empty">还没有留言。第一条就留给你了。</p>
      ) : (
        <ol class="feed">
          {entries.map((entry) => (
            <li class="entry" id={`entry-${entry.id}`} data-reveal>
              <div class="entry-head">
                <time datetime={entry.createdAt}>{formatDateTime(new Date(entry.createdAt))}</time>
                {entry.kind === 'diary' ? (
                  <>
                    <span class="who">{site.name}</span>
                    <span class="badge">站主日记</span>
                  </>
                ) : (
                  <>
                    <span class="who">{entry.nickname ?? '匿名'}</span>
                    {isImpostor(entry.nickname) && <span class="badge badge-fake">冒牌🤡<!-- taste-skill-ignore: 🤡 属于彩蛋徽标文案，不是图标替代 --></span>}
                  </>
                )}
              </div>

              {entry.body && <p class="text">{entry.body}</p>}

              {entry.attachments.length > 0 && (
                <ul class="shots">
                  {entry.attachments.map((image) => (
                    <li>
                      <a href={`/uploads/${image.path}`} target="_blank" rel="noopener" title="查看原图">
                        <img
                          src={`/uploads/${image.path}`}
                          alt="留言配图"
                          loading="lazy"
                          decoding="async"
                          width={image.width ?? undefined}
                          height={image.height ?? undefined}
                        />
                      </a>
                    </li>
                  ))}
                </ul>
              )}

              <ReactionBar entry={entry} back="/guestbook" />

              <ReplyList replies={entry.replies} back="/guestbook" />
            </li>
          ))}
        </ol>
      )
    }
  </section>
</BaseLayout>

<style>
  /* ---------- 最近的照片 ---------- */
  .recent {
    margin-bottom: clamp(36px, 6vw, 56px);
  }

  .recent-label {
    color: var(--text-muted);
    margin-bottom: 12px;
  }

  .recent-list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(10px, 1.6vw, 16px);
    margin: 0 0 14px;
    padding: 0;
    list-style: none;
  }

  /* 手机上四列太挤，标题会被压成一字一行 */
  @media (max-width: 640px) {
    .recent-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .recent-item {
    display: block;
    color: var(--text);
  }

  .recent-shot {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--bg-sunken);
  }

  .recent-shot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 600ms var(--ease-out);
  }

  .recent-item:hover .recent-shot :global(img) {
    transform: scale(1.04);
  }

  .recent-title {
    display: block;
    margin-top: 8px;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--text-soft);
  }

  .recent-item:hover .recent-title {
    color: var(--accent);
  }

  .page-head {
    padding-block: clamp(44px, 7vw, 84px) clamp(16px, 2.4vw, 22px);
  }

  .lead {
    margin-top: 14px;
    max-width: 46ch;
    font-size: 1.25rem;
    line-height: 1.55;
    color: var(--text-soft);
  }

  /* 状态提示：左侧一条色条，成功用强调色，其余用正文色，不写死颜色 */
  .notice {
    margin-top: clamp(16px, 2.5vw, 22px);
    padding: 12px 16px;
    border-left: 3px solid var(--line-strong);
    background: var(--bg-sunken);
    border-radius: 0;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--text-soft);
  }

  .notice-ok {
    border-left-color: var(--accent);
    color: var(--text);
  }

  .notice-warn {
    border-left-color: var(--text-muted);
    color: var(--text);
  }

  .write {
    margin-top: clamp(20px, 3vw, 32px);
  }

  .gb-form {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: clamp(18px, 2.6vw, 26px);
    max-width: 720px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  /* 昵称与配图都是短字段，并排省一行高度；400px 以下再拆回单列 */
  .field-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(18px, 2.6vw, 26px);
  }

  @media (max-width: 640px) {
    .field-row {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .field label {
    font-family: var(--font-mono); /* taste-skill-ignore: 等宽只用在机器口吻的元信息（导航、时间、计数、命令），是这套设计的一部分 */
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--text-soft);
  }

  .field input[type='text'],
  .field textarea {
    width: 100%;
    padding: 10px 12px;
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.65;
    color: var(--text);
    background: var(--bg-elev);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    transition: border-color var(--dur-2) var(--ease-out);
  }

  .field textarea {
    min-height: 132px;
    resize: vertical;
  }

  /* 昵称是短字段，占满整行会很怪；并排布局里两列等宽，就让它铺满自己那列 */
  .field input[type='text'] {
    max-width: 320px;
  }

  .field-row .field input[type='text'] {
    max-width: none;
  }

  .field input:focus,
  .field textarea:focus {
    border-color: var(--accent);
  }

  /* 上传：原生 input 藏起来，用同一套按钮语言做触发器，状态在右侧说明 */
  .upload {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
  }

  .upload-pick {
    cursor: pointer;
  }

  .sr-only:focus-visible + .upload-pick,
  .upload:focus-within .upload-pick {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .upload-state {
    font-family: var(--font-mono); /* taste-skill-ignore: 等宽只用在机器口吻的元信息（导航、时间、计数、命令），是这套设计的一部分 */
    font-size: 0.8125rem;
    color: var(--text-muted);
    overflow-wrap: anywhere;
  }

  .file-note {
    font-family: var(--font-mono); /* taste-skill-ignore: 等宽只用在机器口吻的元信息（导航、时间、计数、命令），是这套设计的一部分 */
    font-size: 0.8125rem;
    color: var(--accent);
  }

  .file-note:empty {
    display: none;
  }

  /* 校验不过时两处提示都转成语义红 */
  .file-note.is-error,
  .upload-state.is-error {
    color: var(--danger);
  }

  .counter.is-warn {
    color: var(--danger);
  }

  /* flex-wrap 是给表情面板用的：面板靠 flex-basis:100% 独占第二行 */
  .editor-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 12px;
  }

  .counter {
    font-family: var(--font-mono); /* taste-skill-ignore: 等宽只用在机器口吻的元信息（导航、时间、计数、命令），是这套设计的一部分 */
    font-size: 0.8125rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  /* 蜜罐字段：1px 缩到不可见但仍在文档里，而不是 display:none —— 有些爬虫会跳过 display:none 的字段。
     不用 left:-9999px 移出视口：那会把页面的横向范围撑到视口外，也会让空档探测误报。 */
  .hp {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 1px; /* taste-skill-ignore: 蜜罐字段缩到 1px 只为对真人不可见，不是装饰性细线 */
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
  }

  .form-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 2px;
  }

  .hint {
    font-family: var(--font-mono); /* taste-skill-ignore: 等宽只用在机器口吻的元信息（导航、时间、计数、命令），是这套设计的一部分 */
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  /* ---------- 留言列表：一行一条，1px 横线分隔 ---------- */
  .feed {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line); /* taste-skill-ignore: 表单与留言列表的真实分隔，不是装饰性细线 */
  }

  .entry {
    padding-block: clamp(20px, 3vw, 28px);
    scroll-margin-top: calc(var(--header-h) + 20px);
  }

  .entry + .entry {
    border-top: 1px solid var(--line); /* taste-skill-ignore: 表单与留言列表的真实分隔，不是装饰性细线 */
  }

  /* 从别处跳过来的锚点，把署名点亮 */
  .entry:target .who {
    color: var(--accent);
  }

  .entry-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
  }

  .entry-head time {
    font-family: var(--font-mono); /* taste-skill-ignore: 等宽只用在机器口吻的元信息（导航、时间、计数、命令），是这套设计的一部分 */
    font-size: 0.8125rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .who {
    font-size: 1rem;
    font-weight: 550;
    color: var(--text);
  }

  .badge {
    padding: 1px 7px;
    border-radius: 0;
    background: var(--accent-soft);
    font-family: var(--font-mono); /* taste-skill-ignore: 等宽只用在机器口吻的元信息（导航、时间、计数、命令），是这套设计的一部分 */
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--accent);
  }

  /* 用了站主昵称的留言 */
  .badge-fake {
    background: var(--bg-sunken);
    color: var(--text-soft);
  }

  /* 输入昵称时冒出来的彩蛋 */
  .egg {
    margin-top: 2px;
    font-size: 1rem;
    color: var(--accent);
  }

  .egg.pop {
    animation: egg-pop 0.42s var(--ease-out);
  }

  @keyframes egg-pop {
    0% {
      transform: scale(0.94) translateY(-2px);
      opacity: 0;
    }
    100% {
      transform: scale(1) translateY(0);
      opacity: 1;
    }
  }

  /* 保留用户输入的换行，同时保证内容被转义（Astro 默认转义） */
  .text {
    margin-top: 10px;
    max-width: 68ch;
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  /* 配图 */
  .shots {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 200px));
    gap: 10px;
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
  }

  .shots a {
    display: block;
    overflow: hidden;
    background: var(--bg-sunken);
  }

  .shots img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 300px;
    object-fit: cover;
    transition: transform 600ms var(--ease-out);
  }

  .shots a:hover img {
    transform: scale(1.03);
  }
</style>

<script>
  const textarea = document.getElementById('body') as HTMLTextAreaElement | null;
  const counter = document.getElementById('char-count');
  const counterBox = counter?.closest('.counter') ?? null;
  const bodyLimit = Number(textarea?.maxLength ?? 0);

  const updateCount = () => {
    if (!textarea || !counter) return;
    const used = Array.from(textarea.value).length;
    counter.textContent = String(used);
    // 快到上限时提前提醒，别等发不出去
    counterBox?.classList.toggle('is-warn', bodyLimit > 0 && used / bodyLimit >= 0.9);
  };

  textarea?.addEventListener('input', updateCount);
  updateCount();

  // 彩蛋：昵称填成站主自己的，冒一句出来
  const nickname = document.getElementById('nickname') as HTMLInputElement | null;
  const egg = document.getElementById('nickname-egg');
  const owner = (nickname?.dataset.owner ?? '').trim().toLowerCase();

  const checkImpostor = () => {
    if (!nickname || !egg || owner.length === 0) return;

    const isFake = nickname.value.trim().toLowerCase() === owner;
    egg.hidden = !isFake;

    if (isFake) {
      // 去掉再加回来，让动画能重复触发（每次重新输入都会再弹一下）
      egg.classList.remove('pop');
      void egg.offsetWidth;
      egg.classList.add('pop');
    }
  };

  nickname?.addEventListener('input', checkImpostor);
  checkImpostor();

  // 配图：说清楚选了哪几张、超没超限
  const fileInput = document.getElementById('images') as HTMLInputElement | null;
  const fileState = document.getElementById('file-state');
  const fileNote = document.getElementById('file-note');

  const renderFiles = () => {
    if (!fileInput || !fileState || !fileNote) return;

    const files = Array.from(fileInput.files ?? []);
    const maxImages = Number(fileInput.dataset.maxImages ?? 0);
    const maxMb = Number(fileInput.dataset.maxMb ?? 0);

    if (files.length === 0) {
      fileState.textContent = '未选择图片';
      fileNote.textContent = '';
      fileState.classList.remove('is-error');
      fileNote.classList.remove('is-error');
      delete fileInput.dataset.invalid;
      return;
    }

    fileState.textContent = files
      .map((file) => `${file.name} · ${(file.size / 1024 / 1024).toFixed(1)} MB`)
      .join('，');

    const oversized = files.find((file) => maxMb > 0 && file.size > maxMb * 1024 * 1024);
    const problem =
      maxImages > 0 && files.length > maxImages
        ? `最多 ${maxImages} 张，先去掉 ${files.length - maxImages} 张。`
        : oversized
          ? `${oversized.name} 超过 ${maxMb} MB，换一张小点的。`
          : '';

    fileNote.textContent = problem;
    fileState.classList.toggle('is-error', problem.length > 0);
    fileNote.classList.toggle('is-error', problem.length > 0);

    if (problem.length > 0) {
      fileInput.dataset.invalid = '1';
    } else {
      delete fileInput.dataset.invalid;
    }
  };

  fileInput?.addEventListener('change', renderFiles);

  // 提交：先拦下超限的图，再锁住按钮防连点
  const form = document.querySelector('.gb-form') as HTMLFormElement | null;
  const sendBtn = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null;

  form?.addEventListener('submit', (event) => {
    if (fileInput?.dataset.invalid === '1') {
      event.preventDefault();
      fileNote?.scrollIntoView({ block: 'center', behavior: 'smooth' });
      return;
    }

    if (sendBtn) {
      sendBtn.disabled = true;
      sendBtn.textContent = '发送中…';
    }
  });

  // 从缓存里退回本页时，把按钮还原
  window.addEventListener('pageshow', () => {
    if (sendBtn) {
      sendBtn.disabled = false;
      sendBtn.textContent = '发送';
    }
  });
</script>
