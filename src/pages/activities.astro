---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { formatDate } from '../utils/format';

const activities = (await getCollection('activities')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<BaseLayout title={`活动 · ${site.name}`} description={`${site.name} 参加过的活动`}>
  <section class="section">
    <div class="section-head">
      <h2>我的活动</h2>
      {activities.length > 0 && <span class="count">{activities.length}</span>}
    </div>

    {
      activities.length === 0 ? (
        <p class="empty">
          还没有活动。在 <code>src/content/activities/</code> 里新建一个目录，
          放一个 <code>index.md</code> 和照片即可。
        </p>
      ) : (
        <ol class="activity-list">
          {activities.map((item) => (
            <li class="activity">
              <a class="thumb" href={`/activities/${item.id}`} tabindex="-1" aria-hidden="true">
                {item.data.cover ? (
                  <Image
                    src={item.data.cover}
                    alt=""
                    widths={[220, 440, 660]}
                    sizes="(max-width: 560px) 90vw, 176px"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span class="thumb-empty" />
                )}
              </a>

              <div class="body">
                <p class="meta">
                  <time datetime={item.data.date.toISOString()}>{formatDate(item.data.date)}</time>
                  {item.data.location && <span> · {item.data.location}</span>}
                </p>

                <h3>
                  <a href={`/activities/${item.id}`}>{item.data.title}</a>
                </h3>

                {item.data.summary && <p class="summary">{item.data.summary}</p>}

                <p class="more">
                  {item.data.photos.length > 0
                    ? `${item.data.photos.length} 张照片 →`
                    : '查看详情 →'}
                </p>
              </div>
            </li>
          ))}
        </ol>
      )
    }
  </section>
</BaseLayout>

<style>
  .activity-list {
    display: grid;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .activity {
    display: grid;
    grid-template-columns: 176px minmax(0, 1fr);
    gap: 22px;
    padding: 16px;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease;
  }

  .activity:hover {
    border-color: var(--border-strong);
    transform: translateY(-2px);
    box-shadow: var(--shadow);
  }

  .thumb {
    display: block;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--bg-sunken);
    border: 1px solid var(--border);
  }

  .thumb :global(img) {
    width: 100%;
    height: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    display: block;
  }

  .thumb-empty {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 3 / 2;
    background: repeating-linear-gradient(
      45deg,
      var(--bg-sunken),
      var(--bg-sunken) 8px,
      var(--border) 8px,
      var(--border) 9px
    );
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 4px;
    justify-content: center;
    min-width: 0;
  }

  .meta {
    font-size: 0.8125rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .body h3 {
    font-size: 1.0625rem;
  }

  .body h3 a {
    color: var(--text);
  }

  .body h3 a:hover {
    color: var(--accent);
  }

  .summary {
    font-size: 0.9375rem;
    color: var(--text-soft);
  }

  .more {
    margin-top: 4px;
    font-size: 0.8125rem;
    color: var(--accent);
  }

  @media (max-width: 560px) {
    .activity {
      grid-template-columns: 1fr;
      gap: 12px;
    }
  }
</style>
