---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Gallery from '../../components/Gallery.astro';
import { site } from '../../data/site';
import { formatDate } from '../../utils/format';
import {
  applyActivity,
  getContent,
  getOverride,
  listContent,
  overridesBySlug,
  parseActivityDate,
  rowToActivity,
  type ActivityView,
} from '../../lib/content';

// 详情页是构建期产物：静态 Markdown 条目 + 后台新建的活动都在构建时展开成路径，
// 后台保存内容后会触发整体重建（见 lib/rebuild.ts）。
export async function getStaticPaths() {
  const overrides = overridesBySlug('activity');
  const entries = await getCollection('activities');
  return [
    ...entries
      .filter((item) => overrides.get(item.id)?.status !== 'hidden')
      .map((item) => ({ params: { slug: item.id } })),
    // 后台新建的活动：对外 id 是 custom-<行号>
    ...listContent('activity')
      .filter((row) => !row.slug && row.status !== 'hidden')
      .map((row) => ({ params: { slug: `custom-${row.id}` } })),
  ];
}

const slug = Astro.params.slug ?? '';
const overrides = overridesBySlug('activity');
const entries = await getCollection('activities');
const entry = entries.find((item) => item.id === slug) ?? null;

// 后台新建的活动在库里 slug 是空的，对外 id 是 custom-<行号>（rowToActivity 定的），
// 所以这里要把 custom-N 反查回那一行，不能走 slug 匹配。
const customId = slug.startsWith('custom-') ? Number(slug.slice('custom-'.length)) : NaN;
const customRow = Number.isInteger(customId) && customId > 0 ? getContent(customId) : null;
const isCustom = Boolean(customRow && customRow.kind === 'activity' && !customRow.slug);

// 后台新建、或覆盖了静态条目的活动
const override = isCustom ? customRow : getOverride('activity', slug);
if (!entry && !override) {
  return Astro.redirect('/404');
}
// 隐藏的自定义条目从列表里消失，详情页也不该还能打开
if (isCustom && override?.status === 'hidden') {
  return Astro.redirect('/404');
}

const photosFromDb = override?.photos ?? [];
const base: ActivityView = entry
  ? {
      id: entry.id,
      title: entry.data.title,
      date: entry.data.date,
      location: entry.data.location,
      summary: entry.data.summary,
      cover: entry.data.cover ?? null,
      photos: entry.data.photos,
      captions: entry.data.captions,
      order: entry.data.order,
    }
  : rowToActivity(override!);
const activity = override ? applyActivity(override, base) : base;

// 覆盖行没写正文时，仍然用 Markdown 的正文；后台新建的用纯文本分段
const markdown = entry && !override?.body ? await render(entry) : null;
const MarkdownContent = markdown?.Content;
const bodyText = activity.body ?? '';
const paragraphs = bodyText
  .split(/\n{2,}/)
  .map((line) => line.trim())
  .filter(Boolean);

// 「上一条」＝ 列表里时间更新的那条（静态条目和后台新建的都算，可能互相跳）
const navItems = [
  ...entries
    .filter((item) => overrides.get(item.id)?.status !== 'hidden')
    .map((item) => {
      const row = overrides.get(item.id);
      const date = row?.date ? parseActivityDate(row.date) : null;
      return {
        id: item.id,
        title: row?.title || item.data.title,
        date: date && !Number.isNaN(date.getTime()) ? date : item.data.date,
      };
    }),
  ...listContent('activity')
    .filter((row) => !row.slug)
    .map((row) => {
      const view = rowToActivity(row);
      return { id: view.id, title: view.title, date: view.date };
    }),
].sort((a, b) => b.date.valueOf() - a.date.valueOf());
const prevItem = navItems.find(
  (item) => item.id !== activity.id && item.date.valueOf() > activity.date.valueOf(),
);
const prev = prevItem ? { id: prevItem.id, title: prevItem.title } : null;

const title = activity.title;
const summary = activity.summary;
const location = activity.location;
const cover = activity.cover;
const photos = activity.photos;
const captions = activity.captions;
const ogImage = entry ? `/og/activities/${entry.id}.png` : undefined;
---

<BaseLayout
  title={`${title} · ${site.name}`}
  description={summary ?? title}
  ogImage={`/og/activities/${activity.id}.png`}
  ogType="article"
>
  <article class="activity-detail">
    <header class="page-head" data-reveal>
      <h1 data-reveal>{title}</h1>
      <p class="meta mono">
        <time datetime={activity.date.toISOString()}>{formatDate(activity.date)}</time>
        {location && <span> · {location}</span>}
      </p>
    </header>

    {summary && <p class="lede" data-reveal>{summary}</p>}

    {
      cover && (
        <div class="cover notched" data-reveal>
          {typeof cover === 'string' ? (
            <img src={cover} alt={title} loading="eager" decoding="async" />
          ) : (
            <Image
              src={cover}
              data-drift
              alt={title}
              widths={[640, 900, 1400]}
              sizes="(max-width: 1040px) 100vw, 976px"
              loading="eager"
              decoding="async"
            />
          )}
        </div>
      )
    }

    <div class="prose" data-reveal>
      {MarkdownContent ? <MarkdownContent /> : paragraphs.map((text) => <p>{text}</p>)}
    </div>

    {
      photos.length > 0 && (
        <section class="section photos" aria-label="照片" data-reveal>
          <div class="section-head">
            <h2>照片</h2>
            <span class="count">{photos.length}</span>
          </div>
          <Gallery photos={photos} captions={captions} alt={title} />
        </section>
      )
    }

    <footer class="detail-foot" data-reveal>
      {
        prev ? (
          <a class="link" href={`/activities/${prev.id}`}>
            ← 上一条 · {prev.title}
          </a>
        ) : (
          <span class="mono muted">已经是最新一条</span>
        )
      }
      <a class="link" href="/activities">
        全部活动
        <span class="arrow" aria-hidden="true">↗</span>
      </a>
    </footer>
  </article>
</BaseLayout>

<style>
  .activity-detail {
    padding-block: clamp(40px, 6vw, 72px) 0;
  }

  .meta {
    margin-top: 14px;
    color: var(--text-muted);
  }

  /* 详情页标题是整句活动名，字号收到 3.5rem 以内，避免中文在词中间折行 */
  .activity-detail h1 {
    font-size: clamp(2.25rem, 1.1rem + 3.4vw, 3.5rem);
    line-height: 1.04;
  }

  .cover {
    margin-top: clamp(24px, 4vw, 40px);
    background: var(--bg-sunken);
  }

  .cover :global(img) {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  /* 摘要当引导句：比正文大一号，行宽压在 60ch 内 */
  .lede {
    margin-top: clamp(24px, 4vw, 34px);
    max-width: 60ch;
    font-size: clamp(1.125rem, 1rem + 0.45vw, 1.3125rem);
    line-height: 1.55;
    color: var(--text);
    text-wrap: balance;
  }

  .prose {
    margin-top: clamp(20px, 3vw, 28px);
    overflow-wrap: break-word;
  }

  .detail-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px 28px;
    margin-top: clamp(64px, 9vw, 104px);
    padding: 20px 22px;
    background: var(--bg-sunken);
  }

  .detail-foot .link {
    max-width: 100%;
    overflow-wrap: anywhere;
  }
</style>
