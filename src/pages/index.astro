---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { isExternal, normalizeHref } from '../utils/link';
import stopoverArt from '../assets/projects/stopover-gameplay.png';

const socials = site.socials
  .map((s) => ({ ...s, href: normalizeHref(s.href) }))
  .filter((s) => s.href.length > 0);

// 最新一条活动：首屏下面紧跟它，让「最近在做什么」有实况
const latest = (await getCollection('activities'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .at(0);

const fmt = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
  timeZone: 'Asia/Shanghai',
});
const latestDate = latest ? fmt.format(latest.data.date).replace(/\//g, '.') : '';

// 首页只露三个有截图的代表作，其余去 /projects 看
// 只挑横幅类的封面：细长的界面截图塞进 16:10 的框里会糊成一条白带
const picks = (await getCollection('projects'))
  .sort((a, b) => a.data.order - b.data.order)
  .filter((p) => p.data.cover && p.data.cover.width / p.data.cover.height <= 2.4)
  .slice(0, 3);

const total = (await getCollection('projects')).length;
---

<BaseLayout title={`${site.name} · 个人主页`} description={site.description}>
  <section class="hero">
    <div class="hero-copy">
      <h1>{site.name}</h1>
      <p class="lead">在川大读计算机，大三。作业、课设、小工具都是自己 vibe coding 出来的，做完就发到这个站上。</p>

      <p class="status" data-reveal>
        <span class="prompt" aria-hidden="true">$</span>
        <span class="cmd">now</span>
        <span class="out">{site.status}</span>
      </p>

      <div class="actions" data-reveal>
        <a class="btn" href="/projects">看我的项目</a>
        {
          socials.map((s) => (
            <a
              class="btn btn-ghost"
              href={s.href}
              target={isExternal(s.href) ? '_blank' : undefined}
              rel="me noopener"
            >
              {s.label}
              <span class="arrow" aria-hidden="true">↗</span>
            </a>
          ))
        }
        <a class="btn btn-ghost" href="/guestbook">留言</a>
      </div>

      <p class="where mono" data-reveal>
        {site.location} / 四川大学 · 计算机科学与技术
      </p>
    </div>

    <figure class="hero-art" data-reveal>
      <div class="plate notched">
        <Image
          src={stopoverArt}
          alt="Stopover 的游戏画面：像素风的教室，公主站在书架和茶杯之间"
          widths={[560, 840, 1200]}
          sizes="(max-width: 900px) 100vw, 560px"
          loading="eager"
          data-drift
        />
      </div>
      <figcaption class="mono">
        <span class="cap-dot" aria-hidden="true">◤</span>
        Stopover · 2026 夏 · NUS 2D 游戏开发课作品
      </figcaption>
    </figure>
  </section>

  {
    latest && (
      <a class="latest" href={`/activities/${latest.id}/`} data-reveal>
        <div class="latest-shot">
          {latest.data.cover ? (
            <Image
              src={latest.data.cover}
              alt={latest.data.title}
              widths={[240, 360, 480]}
              sizes="(max-width: 720px) 100vw, 220px"
              data-drift
            />
          ) : (
            <span class="latest-blank mono">no photo</span>
          )}
        </div>
        <div class="latest-body">
          <p class="latest-meta mono">
            {latestDate}
            {latest.data.location && <span> · {latest.data.location}</span>}
          </p>
          <h2 class="latest-title">{latest.data.title}</h2>
          {latest.data.summary && <p class="latest-summary">{latest.data.summary}</p>}
          <span class="link">
            看照片
            <span class="arrow" aria-hidden="true">↗</span>
          </span>
        </div>
      </a>
    )
  }

  <section class="section" id="work">
    <div class="section-head">
      <h2>代表作</h2>
      <span class="count">{total}</span>
    </div>
    <ul class="picks">
      {
        picks.map((project) => (
          <li data-reveal>
            <a class="pick" href="/projects">
              <div class="pick-shot">
                <Image
                  src={project.data.cover!}
                  alt={project.data.coverAlt ?? project.data.title}
                  widths={[320, 480, 640]}
                  sizes="(max-width: 720px) 100vw, 300px"
                  data-drift
                />
              </div>
              <p class="pick-title">{project.data.title}</p>
              <p class="pick-meta mono">{[project.data.period, project.data.tags.join(' · ')].filter(Boolean).join(' / ')}</p>
            </a>
          </li>
        ))
      }
    </ul>
    <a class="link more" href="/projects">全部项目 <span class="arrow" aria-hidden="true">↗</span></a>
  </section>

  <section class="section" id="about">
    <div class="section-head">
      <h2>关于我</h2>
    </div>
    <div class="about-grid">
      <div class="prose" data-reveal>
        {site.about.map((p) => <p>{p}</p>)}
        <p class="contacts">
          {
            site.contacts.map((c) => (
              <span class="contact mono">
                {c.label} {c.value}
              </span>
            ))
          }
        </p>
      </div>
      <div class="tools" data-reveal>
        <p class="tools-label mono">工具箱</p>
        <ul class="chips">
          {site.skills.map((s) => <li class="chip">{s}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section" id="path">
    <div class="section-head">
      <h2>经历</h2>
      <span class="count">{site.experience.length}</span>
    </div>
    <div class="path-grid">
      <ol class="timeline">
        {
          site.experience.map((item) => (
            <li class="entry" data-reveal>
              <p class="entry-period mono">{item.period}</p>
              <div class="entry-body">
                <h3>{item.title}</h3>
                {item.org && <p class="entry-org">{item.org}</p>}
                {item.desc && <p class="entry-desc">{item.desc}</p>}
              </div>
            </li>
          ))
        }
      </ol>

      <div class="hobbies" data-reveal>
        <p class="tools-label mono">兴趣</p>
        <ul>
          {
            site.hobbies.map((hobby) => (
              <li class="hobby">
                <span class="hobby-name">{hobby.name}</span>
                {hobby.note && <span class="hobby-note mono">{hobby.note}</span>}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- 首屏 ---------- */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(28px, 4.5vw, 56px);
    padding-block: clamp(44px, 7vw, 88px) clamp(32px, 5vw, 52px);
  }

  .hero h1 {
    font-size: clamp(2.6rem, 1rem + 5.3vw, 5.25rem);
    letter-spacing: -0.045em;
  }

  .lead {
    margin-top: 22px;
    max-width: 20em;
    font-size: clamp(1.125rem, 1rem + 0.45vw, 1.3125rem);
    line-height: 1.55;
    color: var(--text-soft);
    text-wrap: pretty;
  }

  .status {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px;
    margin-top: 26px;
    font-family: var(--font-mono); /* taste-skill-ignore: 等宽只用在机器口吻的元信息（导航、时间、计数、命令），是这套设计的一部分 */
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .status .prompt {
    color: var(--accent);
  }

  .status .cmd {
    color: var(--text);
    padding: 1px 6px;
    background: var(--bg-sunken);
  }

  .status .out {
    color: var(--text-soft);
  }

  .where {
    margin-top: 12px;
    color: var(--text-muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 28px;
  }

  .btn {
    padding: 9px 16px;
  }

  .btn .arrow {
    font-size: 0.85em;
    opacity: 0.75;
  }

  .hero-art {
    margin: 0;
  }

  .plate {
    background: var(--bg-elev);
    padding: 12px;
  }

  .plate img {
    width: 100%;
    height: auto;
  }

  .hero-art figcaption {
    margin-top: 12px;
    color: var(--text-muted);
    font-size: 0.8125rem;
  }

  .cap-dot {
    color: var(--accent);
    margin-right: 6px;
  }

  /* ---------- 最新活动 ---------- */
  .latest {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: 26px;
    align-items: center;
    color: var(--text);
  }

  .latest:hover {
    color: var(--text);
  }

  .latest:hover .latest-title {
    color: var(--accent);
  }

  .latest-shot {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--bg-sunken);
    clip-path: polygon(
      0 9px,
      9px 0,
      calc(100% - 9px) 0,
      100% 9px,
      100% calc(100% - 9px),
      calc(100% - 9px) 100%,
      9px 100%,
      0 calc(100% - 9px)
    );
  }

  .latest-shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms var(--ease-out);
  }

  .latest:hover .latest-shot img {
    transform: scale(1.035);
  }

  .latest-blank {
    display: grid;
    place-items: center;
    height: 100%;
    color: var(--text-muted);
  }

  .latest-meta {
    color: var(--text-muted);
  }

  .latest-title {
    margin-top: 6px;
    font-size: 1.5rem;
    transition: color var(--dur-2) var(--ease-out);
  }

  .latest-summary {
    margin-top: 6px;
    color: var(--text-soft);
    font-size: 1rem;
    line-height: 1.6;
    max-width: 58ch;
  }

  .latest .link {
    margin-top: 12px;
  }

  /* ---------- 代表作 ---------- */
  .picks {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(14px, 2vw, 22px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pick {
    display: block;
    color: var(--text);
  }

  .pick-shot {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--bg-sunken);
  }

  .pick-shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms var(--ease-out);
  }

  .pick:hover .pick-shot img {
    transform: scale(1.04);
  }

  .pick-title {
    margin-top: 12px;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .pick-meta {
    margin-top: 3px;
    color: var(--text-muted);
    font-size: 0.8125rem;
  }

  .more {
    margin-top: 18px;
  }

  /* ---------- 关于 ---------- */
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: clamp(24px, 4.5vw, 64px);
    align-items: start;
  }

  .contacts {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    color: var(--text-muted);
  }

  .contact {
    user-select: all;
  }

  .tools-label {
    color: var(--text-muted);
    font-size: 0.8125rem;
    margin-bottom: 12px;
  }

  /* ---------- 经历 / 兴趣 ---------- */
  .path-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 72px);
    align-items: start;
  }

  .timeline {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .entry {
    display: grid;
    grid-template-columns: 128px minmax(0, 1fr);
    gap: 22px;
    padding-block: 18px;
  }

  .entry:first-child {
    padding-top: 0;
  }

  .entry-period {
    color: var(--text-muted);
    padding-top: 4px;
  }

  .entry-org {
    margin-top: 4px;
    color: var(--text-muted);
    font-size: 1rem;
  }

  .entry-desc {
    margin-top: 8px;
    color: var(--text-soft);
  }

  .hobbies ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* 兴趣：一行一条，账号/尺寸这类备注跟在名字后面，别单独占一行 */
  .hobby {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 2px 10px;
    padding-block: 9px;
  }

  .hobby-name {
    font-size: 1rem;
    font-weight: 500;
  }

  .hobby-note {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .hobby:first-child {
    padding-top: 0;
  }

  .hobby-name {
    font-size: 1rem;
    font-weight: 550;
    letter-spacing: -0.01em;
  }

  .hobby-note {
    color: var(--text-muted);
    overflow-wrap: anywhere;
  }

  @media (max-width: 960px) {
    .hero {
      grid-template-columns: 1fr;
      padding-block: 36px 28px;
    }

    .hero-art {
      order: 2;
      max-width: 560px;
    }

    .picks {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .latest {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .latest-shot {
      aspect-ratio: 16 / 9;
    }

    .picks {
      grid-template-columns: 1fr;
    }

    .pick {
      display: grid;
      grid-template-columns: 132px minmax(0, 1fr);
      column-gap: 14px;
      align-items: center;
    }

    .pick-shot {
      grid-row: span 2;
    }

    .pick-title {
      margin-top: 0;
    }

    .about-grid,
    .path-grid {
      grid-template-columns: 1fr;
    }

    .entry {
      grid-template-columns: 1fr;
      gap: 6px;
    }

    .entry-period {
      padding-top: 0;
    }
  }
</style>
