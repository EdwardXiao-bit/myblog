---
// 首页是构建期产物：后台保存内容后会触发一次重建（见 lib/rebuild.ts），
// 数据库里的覆盖行在构建时读进来。
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CardDeck from '../components/CardDeck.astro';
import ActivityRail from '../components/ActivityRail.astro';
import ContributionGrid from '../components/ContributionGrid.astro';
import { site } from '../data/site';
import { isExternal, normalizeHref } from '../utils/link';
import {
  applyActivity,
  applyProject,
  deckFromRows,
  listContent,
  overridesBySlug,
  rowToActivity,
  rowToProject,
  type ActivityView,
  type ProjectView,
} from '../lib/content';
import stopoverArt from '../assets/projects/stopover-gameplay.png';
import guciArt from '../assets/projects/guci-ui.png';
import mathegenArt from '../assets/projects/mathegen-ui.png';
import yunqiArt from '../assets/projects/yunqi-hotel-pms.png';

const socials = site.socials
  .map((s) => ({ ...s, href: normalizeHref(s.href) }))
  .filter((s) => s.href.length > 0);

// 首屏 slogan 窗口：几条短句轮着走，没配置就退回单条 status
const slogans = site.slogans?.length ? site.slogans : [site.status];

// 首屏右侧：四张真实作品/活动图轮播（抽牌式），题注按终端打字机走
const activityOverrides = overridesBySlug('activity');
const staticActivities: ActivityView[] = (await getCollection('activities'))
  .filter((entry) => activityOverrides.get(entry.id)?.status !== 'hidden')
  .map((entry) => {
    const base: ActivityView = {
      id: entry.id,
      title: entry.data.title,
      date: entry.data.date,
      location: entry.data.location,
      summary: entry.data.summary,
      cover: entry.data.cover ?? null,
      photos: entry.data.photos,
      captions: entry.data.captions,
      order: entry.data.order,
    };
    const override = activityOverrides.get(entry.id);
    return override ? applyActivity(override, base) : base;
  });
const customActivities = listContent('activity')
  .filter((row) => !row.slug)
  .map(rowToActivity);
const newest = [...staticActivities, ...customActivities].sort((a, b) => b.date.valueOf() - a.date.valueOf());

const fmt = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
  timeZone: 'Asia/Shanghai',
});

const dotted = (date: Date) => fmt.format(date).replace(/\//g, '.');
const award = newest.find((a) => a.id.includes('4c-qingdao'));

const deckItems = [
  {
    src: stopoverArt,
    alt: 'Stopover 的游戏画面：像素风房间，公主站在书架和茶杯之间',
    caption: 'Stopover · 2026 夏 · NUS 2D 游戏开发课作品',
    href: '/projects',
  },
  {
    src: guciArt,
    alt: '古瓷智缮的模型库界面：青花瓷与钧窑瓷器卡片',
    caption: '古瓷智缮 · 2026 · 4C2026 软件应用与开发赛道 国一',
    href: '/projects',
  },
  {
    src: mathegenArt,
    alt: '四则运算练习网站的排版界面',
    caption: '四则运算练习 · 2026 · 给老师做的随堂练出题工具',
    href: '/projects',
  },
  ...(award
    ? [
        {
          src: award.cover!,
          alt: award.title,
          caption: '中国大学生计算机设计大赛 · 2026.08 · 青岛 国一',
          href: `/activities/${award.id}/`,
        },
      ]
    : []),
  {
    src: yunqiArt,
    alt: '云栖酒店 PMS 的经营统计报表：指标卡与四张图表',
    caption: '云栖酒店 PMS · 2026 秋 · 数据库课程设计',
    href: '/projects',
  },
];

// 后台加过相片堆就整组用后台的，否则用上面写死的默认几张
const deck = deckFromRows(deckItems);

// 横向栏：最近四场活动
const recent = newest.slice(0, 4);
const railItems = recent.map((item) => ({
  src: item.cover ?? undefined,
  alt: item.title,
  meta: dotted(item.date) + (item.location ? ' · ' + item.location : ''),
  title: item.title,
  href: '/activities/' + item.id + '/',
}));
// 首页只露三个有截图的代表作，其余去 /projects 看
// 只挑横幅类的封面：细长的界面截图塞进 16:10 的框里会糊成一条白带
const projectOverrides = overridesBySlug('project');
const staticProjects: ProjectView[] = (await getCollection('projects'))
  .filter((entry) => projectOverrides.get(entry.id)?.status !== 'hidden')
  .map((entry) => {
    const base: ProjectView = {
      id: entry.id,
      title: entry.data.title,
      summary: entry.data.summary,
      href: entry.data.href,
      tags: entry.data.tags,
      period: entry.data.period,
      cover: entry.data.cover ?? null,
      coverAlt: entry.data.coverAlt,
      coverFit: entry.data.coverFit,
      order: entry.data.order,
    };
    const override = projectOverrides.get(entry.id);
    return override ? applyProject(override, base) : base;
  });
const customProjects = listContent('project')
  .filter((row) => !row.slug)
  .map(rowToProject);
const projects = [...staticProjects, ...customProjects].sort(
  (a, b) => a.order - b.order || a.title.localeCompare(b.title, 'zh-CN'),
);
const wideEnough = (p: ProjectView) =>
  !p.cover || typeof p.cover === 'string' || p.cover.width / p.cover.height <= 2.4;
const picks = projects.filter((p) => p.cover && wideEnough(p)).slice(0, 3);

const total = projects.length;
---

<BaseLayout title={`${site.name} · 个人主页`} description={site.description}>
  <section class="hero">
    <div class="hero-copy">
      <h1 data-reveal>{site.name}</h1>
      <p class="lead" data-reveal>在川大读计算机，大三。作业、课设、小工具都是自己 vibe coding 出来的，做完就发到这个站上。</p>

      <div class="win-magnet" data-magnet>
        <div class="win" data-slogan tabindex="0" role="button" aria-label="正在做的事；点击看下一句" data-reveal>
          <div class="win-bar" aria-hidden="true">
            <span class="win-dots"><i></i><i></i><i></i></span>
            <span class="win-path">~/now</span>
          </div>
          <div class="win-body">
            <span class="win-prompt" aria-hidden="true">$</span>
            <span class="win-frame">
              <span class="win-line" data-slogan-line>{slogans[0]}</span>
              <span class="win-caret" data-slogan-caret aria-hidden="true"></span>
            </span>
          </div>
        </div>
      </div>
      <script type="application/json" id="slogan-data" set:html={JSON.stringify(slogans)}></script>

      <div class="actions" data-reveal>
        <a class="btn" href="/projects">看我的项目</a>
        {
          socials.map((s) => (
            <a
              class="btn btn-ghost"
              href={s.href}
              target={isExternal(s.href) ? '_blank' : undefined}
              rel="me noopener"
            >
              {s.icon === 'github' && (
                <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path
                    fill="currentColor"
                    d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.5-1.4-1.9-1.4-1.9-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.6 18.3 5 18.3 5c.6 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3"
                  />
                </svg>
              )}
              {s.icon === 'email' && (
                <svg
                  class="icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  focusable="false"
                >
                  <rect x="2.5" y="5" width="19" height="14" rx="2.2" />
                  <path d="m3.4 6.8 8.6 5.6 8.6-5.6" />
                </svg>
              )}
              {s.label}
              {!s.icon && <span class="arrow" aria-hidden="true">↗</span>}
            </a>
          ))
        }
        <a class="btn btn-ghost" href="/guestbook">留言</a>
      </div>

      <p class="where mono" data-reveal>
        {site.location} / 四川大学 · 计算机科学与技术
      </p>
    </div>

    <div class="hero-art" data-reveal>
      <CardDeck items={deck} />
    </div>

    <div class="hero-contrib" data-reveal>
      <ContributionGrid />
    </div>
  </section>

  {
    recent.length > 0 && (
      <section class="section rail-section" aria-labelledby="recent-h">
        <div class="section-head">
          <h2 id="recent-h">最近</h2>
          <span class="count">{recent.length}</span>
        </div>
        <ActivityRail items={railItems} />
      </section>
    )
  }

  <section class="section" id="work">
    <div class="section-head">
      <h2>代表作</h2>
      <span class="count">{total}</span>
    </div>
    <ul class="picks">
      {
        picks.map((project) => (
          <li data-reveal>
            <a class="pick" href="/projects" data-tilt>
              <div class="pick-shot">
                {typeof project.cover === 'string' ? (
                  <img src={project.cover} alt={project.coverAlt ?? project.title} decoding="async" />
                ) : (
                  <Image
                    src={project.cover!}
                    alt={project.coverAlt ?? project.title}
                    widths={[320, 480, 640]}
                    sizes="(max-width: 720px) 100vw, 300px"
                    data-drift
                  />
                )}
              </div>
              <p class="pick-title">{project.title}</p>
              <p class="pick-meta mono">{[project.period, project.tags.join(' · ')].filter(Boolean).join(' / ')}</p>
            </a>
          </li>
        ))
      }
    </ul>
    <a class="link more" href="/projects">全部项目 <span class="arrow" aria-hidden="true">↗</span></a>
  </section>

  <section class="section" id="about">
    <div class="section-head">
      <h2>关于我</h2>
    </div>
    <div class="about-grid">
      <div class="prose" data-reveal>
        {site.about.map((p) => <p>{p}</p>)}
        <p class="contacts">
          {
            site.contacts.map((c) => (
              <span class="contact mono">
                {c.label} {c.value}
              </span>
            ))
          }
        </p>
      </div>
      <div class="tools" data-reveal>
        <p class="tools-label mono">工具箱</p>
        <ul class="chips">
          {site.skills.map((s) => <li class="chip">{s}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section" id="path">
    <div class="section-head">
      <h2>经历</h2>
      <span class="count">{site.experience.length}</span>
    </div>
    <div class="path-grid">
      <ol class="timeline">
        {
          site.experience.map((item) => (
            <li class="entry" data-reveal>
              <p class="entry-period mono">{item.period}</p>
              <div class="entry-body">
                <h3>{item.title}</h3>
                {item.org && <p class="entry-org">{item.org}</p>}
                {item.desc && <p class="entry-desc">{item.desc}</p>}
              </div>
            </li>
          ))
        }
      </ol>

      <div class="hobbies" data-reveal>
        <p class="tools-label mono">兴趣</p>
        <ul>
          {
            site.hobbies.map((hobby) => (
              <li class="hobby">
                <span class="hobby-name">{hobby.name}</span>
                {hobby.note && <span class="hobby-note mono">{hobby.note}</span>}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <script>
    import { initMagnets } from '../scripts/magnet';

    // slogan 窗口：细光标扫过 → 文字跟着光标显出 → 停几秒 → 光标扫回、文字被一路擦掉 → 下一句。
    // 扫描速度按行宽算（≈0.5px/ms），长短句打起来一样快；点一下窗口可以跳到下一条。
    // 双引号里的片段渲染成 accent 色（伪指令的参数）；reduced-motion 下只静态显示第一句。
    const win = document.querySelector('[data-slogan]');
    const data = document.getElementById('slogan-data');
    if (win && data) {
      const lines = JSON.parse(data.textContent || '[]');
      const line = win.querySelector('[data-slogan-line]');
      const caret = win.querySelector('[data-slogan-caret]');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
      const HOLD = 4200;
      const GAP = 80;
      const SPEED = 0.5; // px/ms：430px 的长句约 860ms，235px 的短句约 470ms
      const REWIND_RATIO = 1.7; // 光标回退比入场快这么多倍
      let revealMs = 620;
      let rewindMs = 360;
      let index = 0;
      let revealTimer = 0;
      let advanceTimer = 0;
      let busy = false;

      const esc = (text) =>
        text.replace(/[&<>"']/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch]));
      // 双引号包住的片段 → accent 色的参数
      const render = (text) =>
        text
          .split('"')
          .map((part, i) => (i % 2 ? `<span class="win-arg">${esc(part)}</span>` : esc(part)))
          .join('"');

      const width = () => line.getBoundingClientRect().width;
      const park = () => {
        caret.style.left = width() + 'px';
      };

      const show = () => {
        line.innerHTML = render(lines[index]);
        line.classList.remove('is-out', 'is-in');
        caret.classList.remove('is-idle');
        win.classList.remove('is-holding');
        caret.style.transition = 'none';
        caret.style.left = '0px';
        void line.offsetWidth;

        // 按这一行的实际宽度定扫描时长，长度不同的句子打字速度才一致
        const w = width();
        revealMs = Math.round(Math.min(1300, Math.max(340, w / SPEED)));
        rewindMs = Math.max(220, Math.round(revealMs / REWIND_RATIO));
        const ease = 'cubic-bezier(0.22, 0.61, 0.36, 1)';
        line.style.transition = `clip-path ${revealMs}ms ${ease}`;
        caret.style.transition = `left ${revealMs}ms ${ease}`;
        line.classList.add('is-in');
        park();
        revealTimer = window.setTimeout(() => {
          win.classList.add('is-holding');
          caret.classList.add('is-idle');
          park();
        }, revealMs);
        advanceTimer = window.setTimeout(next, revealMs + HOLD);
      };

      const next = () => {
        window.clearTimeout(advanceTimer);
        window.clearTimeout(revealTimer);
        caret.classList.remove('is-idle');
        win.classList.remove('is-holding');
        line.style.transition = `clip-path ${rewindMs}ms linear`;
        line.classList.remove('is-in');
        line.classList.add('is-out');
        caret.style.transition = `left ${rewindMs}ms linear`;
        caret.style.left = '0px';
        window.setTimeout(() => {
          index = (index + 1) % lines.length;
          window.setTimeout(show, GAP);
        }, rewindMs);
      };

      const skip = () => {
        if (busy) return;
        busy = true;
        next();
        window.setTimeout(() => {
          busy = false;
        }, revealMs + rewindMs + GAP);
      };

      if (reduce.matches || lines.length < 2) {
        line.innerHTML = render(lines[0]);
        line.classList.add('is-in');
        caret.classList.remove('is-idle');
        park();
      } else {
        show();
        win.addEventListener('click', skip);
        win.addEventListener('keydown', (event) => {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            skip();
          }
        });
        reduce.addEventListener('change', (event) => {
          if (!event.matches) return;
          window.clearTimeout(revealTimer);
          window.clearTimeout(advanceTimer);
          line.innerHTML = render(lines[0]);
          line.style.transition = 'none';
          line.classList.remove('is-out', 'is-in');
          caret.classList.remove('is-idle');
          win.classList.remove('is-holding');
          caret.style.left = '0px';
        });
      }

      // 字体是后加载的：等 webfont 就位再量一次文字宽度，光标不会停在半路
      document.fonts?.ready.then(() => {
        if (line.classList.contains('is-in')) park();
      });
    }

    // 磁吸悬浮 + 按压缩放：实现见 src/scripts/magnet.ts（留言板的输入框也用同一套）
    initMagnets();
  </script>
</BaseLayout>

<style>
  /* ---------- 横向活动栏 ---------- */
  .rail-section {
    margin-top: clamp(8px, 2vw, 18px);
  }

  /* ---------- 首屏 ---------- */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(24px, 3.6vw, 46px);
    padding-block: clamp(30px, 4.6vw, 58px) clamp(20px, 3vw, 32px);
  }

  .hero-contrib {
    grid-column: 1 / -1;
    margin-top: clamp(18px, 2.6vw, 30px);
    padding-top: clamp(14px, 2vw, 22px);
  }

  .hero h1 {
    font-size: clamp(2.6rem, 1rem + 5.3vw, 5.25rem);
    letter-spacing: -0.045em;
  }

  .lead {
    margin-top: 22px;
    max-width: 20em;
    font-size: clamp(1.125rem, 1rem + 0.45vw, 1.3125rem);
    line-height: 1.55;
    color: var(--text-soft);
    text-wrap: pretty;
  }

  /* 磁吸外壳：只负责位移与按压缩放，玻璃本身的样式留在 .win 上。
     悬浮时给一层很淡的外阴影，让窗口像离纸面一点点。 */
  .win-magnet {
    width: 100%;
    max-width: 470px;
    margin-top: 26px;
    border-radius: 3px;
    transition: box-shadow var(--dur-2) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .win-magnet:hover {
      box-shadow: var(--win-lift);
    }
  }

  /* 首屏 slogan 窗口：纸上一扇偏灰黑的磨砂玻璃小窗。
     两套主题都是暗玻璃——终端本来就该是暗的——背后的点阵与指针光晕会透上来。 */
  .win {
    position: relative;
    width: 100%;
    height: 74px;
    overflow: hidden;
    border: 1px solid var(--win-line);
    border-radius: 3px;
    color: var(--win-fg);
    background: var(--win-bg);
    background-image: var(--win-tint);
    -webkit-backdrop-filter: var(--win-filter);
    backdrop-filter: var(--win-filter);
    box-shadow:
      inset 0 1px 0 var(--win-hi),
      inset 0 -1px 0 var(--win-lo);
    cursor: pointer;
  }

  .win:focus-visible {
    outline: 1px solid var(--win-accent);
    outline-offset: 3px;
  }

  /* backdrop-filter 不可用时退回不透明暗窗，不靠透明也能读 */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .win {
      background: var(--win-solid);
      background-image: none;
    }
  }

  .win-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 22px;
    padding: 0 9px;
    background: color-mix(in srgb, var(--win-fg) 7%, transparent);
    border-bottom: 1px solid var(--win-line);
  }

  .win-dots {
    display: flex;
    gap: 5px;
  }

  .win-dots i {
    display: block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--win-fg-dim);
  }

  .win-dots i:nth-child(1) {
    background: #c9b4a6;
  }

  .win-dots i:nth-child(2) {
    opacity: 0.75;
  }

  .win-dots i:nth-child(3) {
    opacity: 0.5;
  }

  .win-path {
    font-family: var(--font-mono);
    font-size: 9px;
    line-height: 1;
    letter-spacing: 0.06em;
    color: var(--win-fg-dim);
  }

  .win-body {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 51px;
    padding: 0 12px;
    font-family: var(--font-mono);
    font-size: 14px;
  }

  .win-prompt {
    font-size: 13px;
    color: var(--win-accent);
  }

  .win-frame {
    position: relative;
    display: inline-block;
  }

  .win-line {
    display: block;
    white-space: nowrap;
    color: var(--win-fg);
    clip-path: inset(0 100% 0 0);
  }

  /* 双引号里的参数：跟 `$` 同一个 accent，但不加粗 */
  .win-line .win-arg {
    color: var(--win-accent);
  }

  .win-line.is-in {
    clip-path: inset(0 0 0 0);
    transition: clip-path 620ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  /* 退出：和入场同方向反着走——光标从右扫回起点，文字被它一路擦掉 */
  .win-line.is-out {
    clip-path: inset(0 100% 0 0);
    transition: clip-path 360ms linear;
  }

  .win-caret {
    position: absolute;
    top: 50%;
    left: 0;
    width: 2px;
    height: 15px;
    margin-top: -7.5px;
