---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DotField from '../components/DotField.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description?: string;
  /** 分享卡片图片的站内路径，默认用站点通用卡片 */
  ogImage?: string;
  ogType?: 'website' | 'article';
}

const {
  title,
  description = '个人主页',
  ogImage = '/og.png',
  ogType = 'website',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const ogImageUrl = new URL(ogImage, Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/ibm-plex-mono-400.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="generator" content={Astro.generator} />

    <meta name="theme-color" id="theme-color" content="#121310" />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} · 订阅`} href="/rss.xml" />

    <script is:inline>
      // 首帧前定两件事：① 主题（默认夜间，只有手动选过浅色才跟随记忆），避免闪白；
      // ② 标记 js 可用，进场动效只在有脚本时才隐藏内容（无脚本时全部直接可见）。
      (function () {
        document.documentElement.classList.add('js');
        try {
          var t = localStorage.getItem('theme');
          var theme = t === 'light' || t === 'dark' ? t : 'dark';
          document.documentElement.dataset.theme = theme;
          var meta = document.getElementById('theme-color');
          if (meta) meta.content = theme === 'light' ? '#e9eae5' : '#121310';
        } catch (e) {}
      })();
    </script>
  </head>

  <body>
    <DotField />
    <a class="skip" href="#main">跳到正文</a>
    <Header />
    <main id="main" class="wrap">
      <slot />
    </main>
    <Footer />

    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    padding: 10px 16px;
    background: var(--accent);
    color: var(--on-accent);
    font-family: var(--font-sans);
    font-size: 0.8125rem;
  }

  .skip:focus {
    left: 16px;
    top: 12px;
  }
</style>
