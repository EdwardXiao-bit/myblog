---
import EmojiPicker from './EmojiPicker.astro';
import { MAX_IMAGES_PER_ENTRY, MAX_IMAGE_BYTES } from '../lib/storage';

/**
 * 站主回复框。功能跟留言表单对齐：文字 + 表情 + 配图。
 * 已经回复过时提交会更新原文（已有配图保留，新选的会追加）。
 */
interface Props {
  entry: { id: number };
}

const { entry } = Astro.props;
const fieldId = `reply-body-${entry.id}`;
const fileId = `reply-images-${entry.id}`;
const maxMb = Math.round(MAX_IMAGE_BYTES / 1024 / 1024);
---

<form class="reply-form" method="post" action="/api/admin" enctype="multipart/form-data">
  <input type="hidden" name="action" value="reply" />
  <input type="hidden" name="id" value={entry.id} />

  <label class="reply-label" for={fieldId}>回复</label>
  <textarea
    id={fieldId}
    name="body"
    rows="2"
    maxlength="1000"
    placeholder="以站主身份回复……"></textarea>

  <div class="reply-tools">
    <EmojiPicker target={fieldId} />
    <span class="counter"><span data-count-for={fieldId}>0</span> / 1000</span>
  </div>

  <div class="reply-file">
    <label class="reply-label" for={fileId}>配图（可选，最多 {MAX_IMAGES_PER_ENTRY} 张，单张不超过 {maxMb} MB）</label>
    <input id={fileId} name="images" type="file" accept="image/*" multiple />
  </div>

  <div class="reply-actions">
    <button type="submit" class="btn">回复</button>
  </div>
</form>

<style>
  .reply-form {
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid var(--line); /* taste-skill-ignore: 表单与留言列表的真实分隔，不是装饰性细线 */
  }

  .reply-label {
    display: block;
    margin-bottom: 8px;
    font-family: var(--font-mono); /* taste-skill-ignore: 等宽只用在机器口吻的元信息（导航、时间、计数、命令），是这套设计的一部分 */
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--text-soft);
  }

  .reply-form textarea {
    width: 100%;
    padding: 10px 12px;
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.65;
    color: var(--text);
    background: var(--bg-elev);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    resize: vertical;
    transition: border-color var(--dur-2) var(--ease-out);
  }

  .reply-form textarea:focus {
    border-color: var(--accent);
  }

  /* flex-wrap 是给表情面板用的：面板靠 flex-basis:100% 独占第二行 */
  .reply-tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 12px;
    margin-top: 10px;
  }

  .counter {
    font-family: var(--font-mono); /* taste-skill-ignore: 等宽只用在机器口吻的元信息（导航、时间、计数、命令），是这套设计的一部分 */
    font-size: 0.8125rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .reply-file {
    margin-top: 14px;
  }

  .reply-file input {
    font-family: var(--font-mono); /* taste-skill-ignore: 等宽只用在机器口吻的元信息（导航、时间、计数、命令），是这套设计的一部分 */
    font-size: 0.8125rem;
    color: var(--text-soft);
  }

  .reply-file input::file-selector-button {
    margin-right: 12px;
    padding: 7px 12px;
    font-family: var(--font-mono); /* taste-skill-ignore: 等宽只用在机器口吻的元信息（导航、时间、计数、命令），是这套设计的一部分 */
    font-size: 0.8125rem;
    color: var(--text);
    background: var(--bg-elev);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    cursor: pointer;
  }

  .reply-actions {
    display: flex;
    /* 提交按钮靠右，和卡片里的其他操作对齐 */
    justify-content: flex-end;
    gap: 8px;
    margin-top: 14px;
  }
</style>

<script>
  // 字数统计。同样加 data-wired 防止重复绑定。
  for (const counter of document.querySelectorAll<HTMLElement>('[data-count-for]')) {
    if (counter.dataset.wired) continue;
    counter.dataset.wired = '1';

    const textarea = document.getElementById(counter.dataset.countFor ?? '') as HTMLTextAreaElement | null;
    if (!textarea) continue;

    const update = () => {
      counter.textContent = String(Array.from(textarea.value).length);
    };
    textarea.addEventListener('input', update);
    update();
  }
</script>
