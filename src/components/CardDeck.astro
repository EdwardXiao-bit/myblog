---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface DeckItem {
  src: ImageMetadata;
  alt: string;
  caption: string;
  href: string;
}

interface Props {
  items: DeckItem[];
}

const { items } = Astro.props;
---

<figure class="deck-figure">
  <div class="deck" data-deck>
    {
      items.map((item, i) => (
        <a
          class="deck-card"
          href={item.href}
          data-deck-card
          data-caption={item.caption}
          style={`--depth:${i}; background:${i === 0 ? 'var(--bg-elev)' : 'var(--bg-sunken)'}`}
          tabindex={i === 0 ? 0 : -1}
        >
          <Image
            src={item.src}
            alt={item.alt}
            widths={[520, 760, 1040]}
            sizes="(max-width: 900px) 92vw, 520px"
            loading={i === 0 ? 'eager' : 'lazy'}
          />
        </a>
      ))
    }
  </div>
  <figcaption class="deck-cap mono">
    <span class="cap-dot" aria-hidden="true">◤</span>
    <span class="cap-text" data-deck-text aria-hidden="true">{items[0].caption}</span>
    <span class="cap-caret" data-deck-caret aria-hidden="true"></span>
    {/* 解码时屏幕上是乱码，读屏要拿到最终那一句 */}
    <span class="sr-only" data-deck-sr>{items[0].caption}</span>
  </figcaption>
</figure>

<style>
  .deck-figure {
    margin: 0;
  }

  /* 牌堆：最上面那张是当前展示的，后面的按 --depth 逐层往上错开，露出发边 */
  .deck {
    position: relative;
    aspect-ratio: 16 / 10;
    /* 后面的牌会绕底边转出去，上下都留点空，别压到上面一行字和下面的题注 */
    margin-block: 22px 18px;
    /* 给扇开的牌留出位置：宽度收一点，转出去的那几层落在右侧留白里，不会把页面撑宽 */
    max-width: min(calc(100% - 56px), 620px);
  }

  @media (max-width: 720px) {
    .deck {
      max-width: calc(100% - 48px);
    }

    .deck-card {
      transform:
        translate(calc(var(--depth) * 7px), calc(var(--depth) * -6px))
        rotate(calc(var(--depth) * 1.8deg))
        scale(calc(1 - var(--depth) * 0.014));
    }
  }

  /* 姿态按「手里的一叠牌」摆：每往下一层就绕底边多转一点、向右上错开一点，
     所以后面的牌会从右下和上方露出照片边 */
  .deck-card {
    position: absolute;
    inset: 0;
    display: block;
    padding: 9px;
    background: var(--bg-elev);
    transform:
      translate(calc(var(--depth) * 13px), calc(var(--depth) * -11px))
      rotate(calc(var(--depth) * 2.9deg))
      scale(calc(1 - var(--depth) * 0.018));
    transform-origin: 50% 100%;
    transition: transform 620ms cubic-bezier(0.16, 0.84, 0.24, 1);
    clip-path: polygon(
      0 12px,
      12px 0,
      calc(100% - 12px) 0,
      100% 12px,
      100% calc(100% - 12px),
      calc(100% - 12px) 100%,
      12px 100%,
      0 calc(100% - 12px)
    );
  }

  .deck-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: var(--bg-sunken);
  }

  .deck-card:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .deck-cap {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin-top: 14px;
    min-height: 1.6em;
    font-size: 0.8125rem;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
  }

  .cap-dot {
    color: var(--accent);
  }

  .cap-text {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .cap-caret {
    flex: 0 0 auto;
    width: 7px;
    height: 1em;
    translate: 0 1px;
    background: var(--accent);
    animation: caret-blink 1.05s steps(1) infinite;
  }

  @keyframes caret-blink {
    50% {
      opacity: 0;
    }
  }

  /* 解码期间光标常亮，像终端正在写；锁定成真字后回到正常闪烁 */
  .deck-cap.is-decoding .cap-caret {
    animation: none;
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .deck-card {
      transition: none;
    }

    .cap-caret {
      animation: none;
    }
  }
</style>

<script>
  const deck = document.querySelector<HTMLElement>('[data-deck]');

  if (deck) {
    const cards = Array.from(deck.querySelectorAll<HTMLAnchorElement>('[data-deck-card]'));
    const figure = deck.closest('figure');
    const capText = figure?.querySelector<HTMLElement>('[data-deck-text]');
    const capSr = figure?.querySelector<HTMLElement>('[data-deck-sr]');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const captions = cards.map((card) => card.dataset.caption ?? '');

    const FLIGHT = 1240;  // 顶牌离开牌堆、再从牌底插回去的总时长
    const FORWARD = 820;  // 下面几张各前进一层
    const INSIDE = 760;   // 时间轴上「拿开停住」那一刻（0.61），此时整张牌与牌堆零重叠
    const CYCLE = 5000;   // 题注解码完到下一次翻牌之间停留多久

    let order = cards.slice();
    let index = 0;
    let timer = 0;       // 下一次翻牌
    let eraseTimer = 0;  // 退格推进（和翻牌分开，悬停清 timer 时不会误杀退格）
    let busy = false;
    // 悬停/键盘聚焦只暂停「下一次翻牌」，题注本身的退格与解码照常走完，
    // 否则在退格途中移入鼠标会把题注停在半截
    let hovering = false;
    let erasing = false;
    const scheduleFlip = (delay = CYCLE) => {
      window.clearTimeout(timer);
      if (hovering) return;
      timer = window.setTimeout(flip, delay);
    };

    const stack = (depth: number) =>
      `translate3d(${depth * 13}px, ${depth * -11}px, 0) rotate(${depth * 2.9}deg) scale(${1 - depth * 0.018})`;

    const layout = () => {
      order.forEach((card, depth) => {
        card.style.setProperty('--depth', String(depth));
        card.style.transform = stack(depth);
        card.style.zIndex = String(cards.length - depth);
        card.tabIndex = depth === 0 ? 0 : -1;
      });
    };

    // 静态姿态直接写在行内，动画结束后再交回样式表
    for (const card of cards) card.style.transition = 'none';
    layout();
    void deck.offsetWidth;
    for (const card of cards) card.style.transition = '';

    if (capText) capText.textContent = captions[0];

    let type: (text: string, done?: () => void) => void;
    let erase: (done: () => void) => void;

    // 窄屏（手机）上大幅度的旋出/插回会顶到屏幕边缘，改成一次安静地淡出换页
    const COMPACT = window.matchMedia('(max-width: 640px)').matches;
    const COMPACT_FLIGHT = 320;

    // 题注在翻牌刚开始时就先退格、再解码下一句，和牌的运动重叠，而不是等牌停稳
    const CAPTION_LEAD = COMPACT ? 60 : 140;
    // 下一句题注必须在 flip() 一开始就定下来：窄屏换层只要 320ms，
    // 而退格要几十个字符、耗时更久，等退格结束再读 index 时它已经被 finish() 加过 1，
    // 会取到再下一张卡的题注（图与字从此错位）。
    const beginCaption = (text: string) => {
      if (!type || !erase) return;
      erase(() => type(text, scheduleFlip));
    };

    const flip = () => {
      // 上一次翻牌还没收尾就先等一会儿，不能把这次直接丢掉，否则题注会停在半截
      if (busy) {
        timer = window.setTimeout(flip, 320);
        return;
      }
      busy = true;
      const top = order[0];
      const rest = order.slice(1);

      // 下面几张各前进一层：从它们现在的姿态平滑走到上一层
      rest.forEach((card, i) => {
        card.animate(
          [{ transform: stack(i + 1) }, { transform: stack(i) }],
          {
            duration: COMPACT ? COMPACT_FLIGHT * 0.9 : FORWARD,
            easing: 'cubic-bezier(0.22, 0.9, 0.24, 1)',
            fill: 'forwards',
          },
        );
      });

      // 顶牌：顺时针旋出到牌堆右边（离开牌堆、与牌堆零重叠），停一下，
      // 换到牌堆下面之后逆时针旋回、从右边插回牌底。全程不靠透明度。
      const w = top.offsetWidth;
      const h = top.offsetHeight;
      const deckRect = deck.getBoundingClientRect();
      const vw = window.innerWidth;
      // 右侧还剩多少地方放这张牌（决定是“旋到右边”还是“先拿开再插回”）
      const avail = vw - deckRect.right;
      const outX = 96;
      const outY = -56;
      const rotLift = 40;
      const rotAway = 52;
      const radAway = (rotAway * Math.PI) / 180;
      const den = w * Math.cos(radAway) + h * Math.sin(radAway);
      const down = avail < 140;
      // 缩放按可用宽度反推：保证整张牌落在牌堆右边、且不出视口
      const awayScale = down
        ? 0.62
        : Math.min(0.5, Math.max(0.3, (avail - 28) / den));
      const bboxW = awayScale * den;
      const bboxH = awayScale * (w * Math.sin(radAway) + h * Math.cos(radAway));
      // transform-origin 在底边中点，旋转后包围盒并不居中：按几何精确算位移
      const cosA = Math.cos(radAway);
      const sinA = Math.sin(radAway);
      const wantedLeft = Math.min(deckRect.right + 14, vw - bboxW - 10);
      const wantedTop = deckRect.top + (h - bboxH) / 2 + h * 0.04;
      const awayX = Math.round(
        wantedLeft - deckRect.left - w / 2 + (awayScale * w * cosA) / 2,
      );
      const awayY = down
        ? Math.round(h * 1.35)
        : Math.round(wantedTop - deckRect.top - h + awayScale * (h * cosA + (w * sinA) / 2));
      const away = `translate3d(${awayX}px, ${awayY}px, 0) rotate(${rotAway}deg) scale(${awayScale})`;
      const rise = down
        ? `translate3d(${Math.round(awayX * 0.55)}px, ${Math.round(awayY + h * 0.1)}px, 0) rotate(20deg) scale(0.72)`
        : `translate3d(${Math.round(awayX * 0.55)}px, ${Math.round(awayY * 0.55)}px, 0) rotate(26deg) scale(${Math.round(Math.max(0.72, awayScale * 1.3) * 100) / 100})`;
      const flight = COMPACT
        ? top.animate(
            [
              { opacity: 1, transform: `${stack(0)} translateY(0)`, easing: 'cubic-bezier(0.4, 0, 0.4, 1)', offset: 0 },
              { opacity: 0, transform: `${stack(0)} translateY(-10px) scale(0.99)`, offset: 1 },
            ],
            { duration: COMPACT_FLIGHT, easing: 'linear', fill: 'forwards' },
          )
        : top.animate(
        [
          { transform: stack(0), easing: 'cubic-bezier(0.2, 0.84, 0.3, 1)', offset: 0 },
          { transform: `translate3d(${outX}px, ${outY}px, 0) rotate(${rotLift}deg) scale(0.95)`, easing: 'cubic-bezier(0.4, 0.02, 0.4, 1)', offset: 0.16 },
          { transform: away, easing: 'linear', offset: 0.44 },
          { transform: away, easing: 'cubic-bezier(0.3, 0, 0.4, 1)', offset: 0.58 },
          { transform: rise, easing: 'cubic-bezier(0.34, 0.8, 0.24, 1)', offset: 0.8 },
          { transform: stack(cards.length - 1), offset: 1 },
        ],
        { duration: FLIGHT, easing: 'linear', fill: 'forwards' },
      );

      // 和飞行同时开始：先退格，再逐字打下一句（句子在这里就锁定）
      const nextCaption = captions[(index + 1) % cards.length];
      window.setTimeout(() => beginCaption(nextCaption), CAPTION_LEAD);

      // 桌面：这张牌已经完全离开牌堆时才换层，遮挡关系的变化看不出来
      // 窄屏：淡出到一半就换层，下面那张自然接上来
      window.setTimeout(() => {
        top.style.zIndex = '0';
        rest.forEach((card, i) => {
          card.style.zIndex = String(rest.length - i);
        });
      }, COMPACT ? COMPACT_FLIGHT / 2 : INSIDE);

      const finish = () => {
        for (const card of cards) {
          for (const anim of card.getAnimations()) anim.cancel();
        }
        order = rest.concat(top);
        deck.appendChild(top);
        for (const card of cards) card.style.transition = 'none';
        layout();
        void deck.offsetWidth;
        for (const card of cards) card.style.transition = '';
        index = (index + 1) % cards.length;
        busy = false;
      };

      if (reduce) {
        for (const card of cards) for (const anim of card.getAnimations()) anim.cancel();
        finish();
        return;
      }

      flight.finished.then(finish).catch(() => {});
    };

    if (!reduce && capText && cards.length > 1) {
      const ERASE = 12;      // 退格速度
      const STEP = 30;       // 每个字符出现的间隔
      const SCRAMBLE = 150;  // 每个字符从乱码锁定成真字要跳多久
      const caption = capText.closest<HTMLElement>('.deck-cap');

      // 乱码按「字符类别」挑，宽度才不会跳：汉字位用等宽汉字，其余位用等宽拉丁/数字
      const CJK_POOL = '龘靐齉爩麤龗灪厵灩鱻龖鸝龢麣爨饢籲纞虋齾甕爝蠡龕鬮籙鑊';
      const ASCII_POOL = 'ABCDEFGHJKLMNPQRSTUVWXYZ0123456789#%&@?/<>[]{}$=+-_*';
      // 按「第几个字 + 第几次跳动」取字符：同一跳里保持不变，下一次跳动才换，像真的在解译
      const glyphAt = (ch: string, i: number, tick: number) => {
        if (ch.trim() === '') return ch;
        const pool = (ch.codePointAt(0) ?? 0) >= 0x2e80 ? CJK_POOL : ASCII_POOL;
        return pool[((i + 1) * 367 + tick * 89) % pool.length];
      };

      // 虚拟时钟 + rAF：悬停/聚焦时停表，离开后接着走，不必重建状态
      let frame = 0;
      let clock = 0;
      let last = 0;
      let decoding = false;
      let target = '';
      let startedAt = 0;
      let settled: (() => void) | null = null;

      const paint = () => {
        const elapsed = clock - startedAt;
        const tick = Math.floor(elapsed / STEP);
        const shown = Math.min(target.length, tick + 1);
        let out = '';
        for (let i = 0; i < shown; i += 1) {
          const ch = target[i];
          out += elapsed < i * STEP + SCRAMBLE ? glyphAt(ch, i, tick) : ch;
        }
        capText.textContent = out;
      };

      const tickFrame = (now: number) => {
        frame = 0;
        if (!decoding) return;
        clock += last ? now - last : 0;
        last = now;
        paint();
        if (clock - startedAt >= target.length * STEP + SCRAMBLE) {
          decoding = false;
          capText.textContent = target;
          if (capSr) capSr.textContent = target;
          caption?.classList.remove('is-decoding');
          const done = settled;
          settled = null;
          done?.();
          return;
        }
        frame = requestAnimationFrame(tickFrame);
      };

      type = (text: string, done?: () => void) => {
        window.clearTimeout(timer);
        window.clearTimeout(eraseTimer);
        erasing = false;
        if (frame) cancelAnimationFrame(frame);
        frame = 0;
        target = text;
        startedAt = clock;
        decoding = true;
        last = 0;
        settled = done ?? null;
        caption?.classList.add('is-decoding');
        paint();
        frame = requestAnimationFrame(tickFrame);
      };

      erase = (done: () => void) => {
        const current = capText.textContent ?? '';
        if (current.length > 0) {
          erasing = true;
          capText.textContent = current.slice(0, -1);
          eraseTimer = window.setTimeout(() => erase(done), ERASE);
        } else {
          erasing = false;
          done();
        }
      };

      // 首屏也解一次码，和后面切换时的手感一致
      type(captions[0], () => scheduleFlip());

      const hold = () => {
        hovering = true;
        window.clearTimeout(timer);
      };
      const release = () => {
        hovering = false;
        // 退格/解码还在走：让它们自己跑完，跑完时再排下一次翻牌
        if (decoding || erasing) return;
        if (!busy) scheduleFlip(1500);
      };
      deck.addEventListener('pointerenter', hold);
      deck.addEventListener('pointerleave', release);
      deck.addEventListener('focusin', hold);
      deck.addEventListener('focusout', (event) => {
        if (!deck.contains(event.relatedTarget as Node | null)) release();
      });
    }
  }
</script>
