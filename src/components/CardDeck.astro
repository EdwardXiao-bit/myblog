---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface DeckItem {
  src: ImageMetadata;
  alt: string;
  caption: string;
  href: string;
}

interface Props {
  items: DeckItem[];
}

const { items } = Astro.props;
---

<figure class="deck-figure">
  <div class="deck" data-deck>
    {
      items.map((item, i) => (
        <a
          class="deck-card"
          href={item.href}
          data-deck-card
          data-caption={item.caption}
          style={`--depth:${i}; background:${i === 0 ? 'var(--bg-elev)' : 'var(--bg-sunken)'}`}
          tabindex={i === 0 ? 0 : -1}
        >
          <Image
            src={item.src}
            alt={item.alt}
            widths={[520, 760, 1040]}
            sizes="(max-width: 900px) 92vw, 520px"
            loading={i === 0 ? 'eager' : 'lazy'}
          />
        </a>
      ))
    }
  </div>
  <figcaption class="deck-cap mono">
    <span class="cap-dot" aria-hidden="true">◤</span>
    <span class="cap-text" data-deck-text>{items[0].caption}</span>
    <span class="cap-caret" data-deck-caret aria-hidden="true"></span>
  </figcaption>
</figure>

<style>
  .deck-figure {
    margin: 0;
  }

  /* 牌堆：最上面那张是当前展示的，后面的按 --depth 逐层往上错开，露出发边 */
  .deck {
    position: relative;
    aspect-ratio: 16 / 10;
    /* 后面的牌会绕底边转出去，上下都留点空，别压到上面一行字和下面的题注 */
    margin-block: 22px 18px;
    /* 给扇开的牌留出位置：宽度收一点，转出去的那几层落在右侧留白里，不会把页面撑宽 */
    max-width: min(calc(100% - 56px), 620px);
  }

  @media (max-width: 720px) {
    .deck {
      max-width: calc(100% - 48px);
    }

    .deck-card {
      transform:
        translate(calc(var(--depth) * 7px), calc(var(--depth) * -6px))
        rotate(calc(var(--depth) * 1.8deg))
        scale(calc(1 - var(--depth) * 0.014));
    }
  }

  /* 姿态按「手里的一叠牌」摆：每往下一层就绕底边多转一点、向右上错开一点，
     所以后面的牌会从右下和上方露出照片边 */
  .deck-card {
    position: absolute;
    inset: 0;
    display: block;
    padding: 9px;
    background: var(--bg-elev);
    transform:
      translate(calc(var(--depth) * 13px), calc(var(--depth) * -11px))
      rotate(calc(var(--depth) * 2.9deg))
      scale(calc(1 - var(--depth) * 0.018));
    transform-origin: 50% 100%;
    transition: transform 620ms cubic-bezier(0.16, 0.84, 0.24, 1);
    clip-path: polygon(
      0 12px,
      12px 0,
      calc(100% - 12px) 0,
      100% 12px,
      100% calc(100% - 12px),
      calc(100% - 12px) 100%,
      12px 100%,
      0 calc(100% - 12px)
    );
  }

  .deck-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: var(--bg-sunken);
  }

  .deck-card:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .deck-cap {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin-top: 14px;
    min-height: 1.6em;
    font-size: 0.8125rem;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
  }

  .cap-dot {
    color: var(--accent);
  }

  .cap-text {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .cap-caret {
    flex: 0 0 auto;
    width: 7px;
    height: 1em;
    translate: 0 1px;
    background: var(--accent);
    animation: caret-blink 1.05s steps(1) infinite;
  }

  @keyframes caret-blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .deck-card {
      transition: none;
    }

    .cap-caret {
      animation: none;
    }
  }
</style>

<script>
  const deck = document.querySelector<HTMLElement>('[data-deck]');

  if (deck) {
    const cards = Array.from(deck.querySelectorAll<HTMLAnchorElement>('[data-deck-card]'));
    const figure = deck.closest('figure');
    const capText = figure?.querySelector<HTMLElement>('[data-deck-text]');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const captions = cards.map((card) => card.dataset.caption ?? '');

    const FLIGHT = 1240;  // 顶牌离开牌堆、再从牌底插回去的总时长
    const FORWARD = 820;  // 下面几张各前进一层
    const INSIDE = 760;   // 时间轴上「拿开停住」那一刻（0.61），此时整张牌与牌堆零重叠

    let order = cards.slice();
    let index = 0;
    let timer = 0;
    let busy = false;

    const stack = (depth: number) =>
      `translate3d(${depth * 13}px, ${depth * -11}px, 0) rotate(${depth * 2.9}deg) scale(${1 - depth * 0.018})`;

    const layout = () => {
      order.forEach((card, depth) => {
        card.style.setProperty('--depth', String(depth));
        card.style.transform = stack(depth);
        card.style.zIndex = String(cards.length - depth);
        card.tabIndex = depth === 0 ? 0 : -1;
      });
    };

    // 静态姿态直接写在行内，动画结束后再交回样式表
    for (const card of cards) card.style.transition = 'none';
    layout();
    void deck.offsetWidth;
    for (const card of cards) card.style.transition = '';

    if (capText) capText.textContent = captions[0];

    let type: (text: string, i?: number) => void;
    let erase: (done: () => void) => void;

    const flip = () => {
      if (busy) return;
      busy = true;
      const top = order[0];
      const rest = order.slice(1);

      // 下面几张各前进一层：从它们现在的姿态平滑走到上一层
      rest.forEach((card, i) => {
        card.animate(
          [{ transform: stack(i + 1) }, { transform: stack(i) }],
          { duration: FORWARD, easing: 'cubic-bezier(0.22, 0.9, 0.24, 1)', fill: 'forwards' },
        );
      });

      // 顶牌：整张牌先离开牌堆（飞到牌堆右下方、和牌堆完全不相交），
      // 再把层级降到牌堆下面，从底下插回去 —— 全程不靠透明度过场。
      const w = top.offsetWidth;
      const h = top.offsetHeight;
      const narrow = w < 480;
      const outX = narrow ? 40 : 96;
      const outY = narrow ? -30 : -56;
      const rotA = narrow ? 34 : 44;
      const rotB = narrow ? 15 : 18;
      const awayX = Math.round(w * (narrow ? 0.2 : 0.3));
      // 离开时略微缩小（像是被拿远），并按缩放后的包围盒算出完全离开牌堆所需的位移
      const awayScale = narrow ? 0.7 : 0.62;
      const rad = (rotB * Math.PI) / 180;
      const awayY = Math.round(h * awayScale * Math.cos(rad) + w * awayScale * Math.sin(rad) + 14);
      const away = `translate3d(${awayX}px, ${awayY}px, 0) rotate(${rotB}deg) scale(${awayScale})`;
      const rise = `translate3d(${Math.round(awayX * 0.62)}px, ${Math.round(awayY * 0.34)}px, 0) rotate(${Math.round(rotB * 0.8)}deg) scale(${awayScale + 0.2})`;
      const flight = top.animate(
        [
          { transform: stack(0), easing: 'cubic-bezier(0.18, 0.86, 0.28, 1)', offset: 0 },
          { transform: `translate3d(${outX}px, ${outY}px, 0) rotate(${rotA}deg) scale(0.95)`, easing: 'cubic-bezier(0.34, 0.02, 0.42, 1)', offset: 0.16 },
          { transform: away, easing: 'linear', offset: 0.47 },
          { transform: away, easing: 'cubic-bezier(0.3, 0, 0.4, 1)', offset: 0.61 },
          { transform: rise, easing: 'cubic-bezier(0.32, 0.86, 0.22, 1)', offset: 0.8 },
          { transform: stack(cards.length - 1), offset: 1 },
        ],
        { duration: FLIGHT, easing: 'linear', fill: 'forwards' },
      );

      // 这张牌已经完全离开牌堆时才换层，所以遮挡关系的变化看不出来
      window.setTimeout(() => {
        top.style.zIndex = '0';
        rest.forEach((card, i) => {
          card.style.zIndex = String(rest.length - i);
        });
      }, INSIDE);

      const finish = () => {
        for (const card of cards) {
          for (const anim of card.getAnimations()) anim.cancel();
        }
        order = rest.concat(top);
        deck.appendChild(top);
        for (const card of cards) card.style.transition = 'none';
        layout();
        void deck.offsetWidth;
        for (const card of cards) card.style.transition = '';
        index = (index + 1) % cards.length;
        busy = false;
        erase(() => type(captions[index]));
      };

      if (reduce) {
        for (const card of cards) for (const anim of card.getAnimations()) anim.cancel();
        finish();
        return;
      }

      flight.finished.then(finish).catch(() => {});
    };

    if (!reduce && capText && cards.length > 1) {
      const CYCLE = 4200;
      const ERASE = 12;
      const TYPE = 22;

      type = (text: string, i = 0) => {
        capText.textContent = text.slice(0, i);
        if (i < text.length) {
          timer = window.setTimeout(() => type(text, i + 1), TYPE);
        } else {
          timer = window.setTimeout(flip, CYCLE);
        }
      };

      erase = (done: () => void) => {
        const current = capText.textContent ?? '';
        if (current.length > 0) {
          capText.textContent = current.slice(0, -1);
          timer = window.setTimeout(() => erase(done), ERASE);
        } else {
          done();
        }
      };

      timer = window.setTimeout(flip, CYCLE);

      const hold = () => window.clearTimeout(timer);
      const release = () => {
        window.clearTimeout(timer);
        timer = window.setTimeout(flip, 1500);
      };
      deck.addEventListener('pointerenter', hold);
      deck.addEventListener('pointerleave', release);
      deck.addEventListener('focusin', hold);
      deck.addEventListener('focusout', (event) => {
        if (!deck.contains(event.relatedTarget as Node | null)) release();
      });
    }
  }
</script>
