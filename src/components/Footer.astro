---
import { site } from '../data/site';
import { isExternal, normalizeHref } from '../utils/link';

const year = new Date().getFullYear();
const links = site.socials
  .map((s) => ({ ...s, href: normalizeHref(s.href) }))
  .filter((s) => s.href.length > 0);
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <p class="footer-line">
      <span class="prompt" aria-hidden="true">$</span>
      © {year} {site.name}
      <span class="sep" aria-hidden="true">·</span>
      <span class="dim">成都</span>
    </p>

    <nav class="footer-links" aria-label="页脚链接">
      {
        links.map((s) => (
          <a href={s.href} target={isExternal(s.href) ? '_blank' : undefined} rel="me noopener">
            {s.label}
          </a>
        ))
      }
      <a href="/rss.xml">RSS</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    flex: none;
    background: var(--bg-sunken);
    padding-block: 20px;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: var(--text-soft);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    align-items: center;
    justify-content: space-between;
  }

  .footer-line {
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .prompt {
    color: var(--accent);
  }

  .sep {
    opacity: 0.5;
  }

  .dim {
    color: var(--text-muted);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .footer-links a {
    color: var(--text-muted);
    transition: color var(--dur-2) var(--ease-out);
  }

  .footer-links a:hover {
    color: var(--accent);
  }

  /* 触屏上把页脚链接撑到 44px 高，间距看起来不变 */
  @media (pointer: coarse) {
    .footer-links {
      gap: 0 14px;
    }

    .footer-links a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding-inline: 10px;
      margin-inline: -10px;
    }
  }
</style>
