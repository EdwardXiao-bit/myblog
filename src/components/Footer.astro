---
import { site } from '../data/site';
import { isExternal, normalizeHref } from '../utils/link';

const year = new Date().getFullYear();
const links = site.socials
  .map((s) => ({ ...s, href: normalizeHref(s.href) }))
  .filter((s) => s.href.length > 0);
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <p class="footer-line">
      <span class="prompt" aria-hidden="true">$</span>
      © {year} {site.name}
      <span class="sep" aria-hidden="true">·</span>
      <span class="dim">成都</span>
    </p>

    <nav class="footer-links" aria-label="页脚链接">
      {
        links.map((s) => (
          <a href={s.href} target={isExternal(s.href) ? '_blank' : undefined} rel="me noopener">
            {s.label}
          </a>
        ))
      }
      <a href="/rss.xml">RSS</a>
    </nav>

    {
      (site.icp || site.police) && (
        <p class="footer-legal">
          {site.icp && (
            <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener nofollow">
              {site.icp}
            </a>
          )}
          {site.police && (
            <a
              href={`https://beian.mps.gov.cn/#/query/webSearch?code=${site.police.replace(/\D/g, '')}`}
              target="_blank"
              rel="noopener noreferrer"
            >
              <img class="footer-beian-icon" src="/beian-gongan.png" alt="" width="18" height="20" />
              {site.police}
            </a>
          )}
        </p>
      )
    }

    <p class="footer-credit">
      前端有 <a href="https://www.stylekit.top" target="_blank" rel="noopener">StyleKit</a> 的支持
    </p>
  </div>
</footer>

<style>
  .site-footer {
    flex: none;
    background: var(--bg-sunken);
    padding-block: 20px;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: var(--text-soft);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    align-items: center;
    justify-content: space-between;
  }

  .footer-line {
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .prompt {
    color: var(--accent);
  }

  .sep {
    opacity: 0.5;
  }

  .dim {
    color: var(--text-muted);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .footer-links a {
    color: var(--text-muted);
    transition: color var(--dur-2) var(--ease-out);
  }

  .footer-links a:hover {
    color: var(--accent);
  }

  /* 备案信息：只有在大陆服务器备案后才显示（site.icp / site.police 有值） */
  .footer-legal {
    width: 100%;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    /* 备案号是真实链接，按正文下限 13px，不再压到 12px */
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .footer-legal a {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--text-muted);
    transition: color var(--dur-2) var(--ease-out);
  }

  /* 公安联网备案图标：官方 36×40 的徽标，按 20px 高排版，跟随文字基线 */
  .footer-beian-icon {
    flex: none;
    width: auto;
    height: 20px;
    border-radius: 1px;
  }

  .footer-legal a:hover {
    color: var(--accent);
  }

  /* 鸣谢：和备案信息同字号，弱化到 muted，链接只在 hover 时变 accent */
  .footer-credit {
    width: 100%;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .footer-credit a {
    color: var(--text-soft);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 3px;
    transition:
      color var(--dur-2) var(--ease-out),
      text-decoration-color var(--dur-2) var(--ease-out);
  }

  .footer-credit a:hover {
    color: var(--accent);
    text-decoration-color: currentColor;
  }

  @media (pointer: coarse) {
    .footer-legal a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding-inline: 10px;
      margin-inline: -10px;
    }
  }

  /* 触屏上把页脚链接撑到 44px 高，间距看起来不变 */
  @media (pointer: coarse) {
    .footer-links {
      gap: 0 14px;
    }

    .footer-links a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding-inline: 10px;
      margin-inline: -10px;
    }
  }
</style>
