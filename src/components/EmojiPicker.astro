---
/**
 * 表情面板：点一下把表情插到指定 textarea 的光标处。
 * 本地实现，没引第三方库。
 *
 * 布局上有个坑：外层 .emoji 用 display: contents，
 * 让「按钮」和「面板」直接参与父容器的 flex 布局——
 * 否则外壳宽度由内容撑开，面板里的 grid 只有一两列宽（曾经就是这样）。
 * 父容器需要 flex-wrap: wrap，面板靠 flex-basis: 100% 独占一行。
 *
 * 页面上可以出现多个实例。脚本只挂一次，靠 data-wired 保证不重复绑定。
 */
interface Props {
  /** 要插入到哪个 textarea（元素 id） */
  target: string;
}

const { target } = Astro.props;

// 按「表情 → 手势 → 心与符号 → 自然 → 吃的 → 玩与物件」排，够日常用
const emojis = [
  '😀', '😃', '😄', '😁', '😆', '😅', '🤣', '😂',
  '🙂', '🙃', '😉', '😊', '😇', '🥰', '😍', '🤩',
  '😘', '😋', '😛', '😜', '🤪', '🤗', '🤔', '🤨',
  '😐', '😏', '🙄', '😬', '😌', '😔', '😪', '😴',
  '🥱', '😷', '🥳', '🥺', '😢', '😭', '😤', '😡',
  '🤯', '😳', '🥵', '🥶', '😱', '😨', '😰', '😵',
  '👍', '👎', '👌', '✌️', '🤞', '🤟', '🤘', '🤙',
  '👈', '👉', '👆', '👇', '✋', '🖐️', '🖖', '👋',
  '🤝', '🙏', '💪', '✍️', '👏', '🙌', '👐', '🤲',
  '❤️', '🧡', '💛', '💚', '💙', '💜', '🖤', '🤍',
  '💔', '💕', '💗', '💖', '✨', '⭐', '🌟', '💫',
  '🔥', '💥', '🎉', '🎊', '🎈', '🎁', '🌸', '🌺',
  '🌻', '🌹', '🌱', '🍀', '🍁', '🌙', '☀️', '🌈',
  '❄️', '💧', '🌊', '🐟', '🐱', '🐶', '🐼', '🦊',
  '☕', '🍵', '🍜', '🍚', '🍕', '🍰', '🍦', '🍺',
  '🚲', '🏊', '🎮', '🎹', '🎸', '🎧', '📷', '📚',
  '💻', '📱', '🎯', '🏀', '⚽', '🚀', '🛠️', '🧩',
];
---

<div class="emoji" data-emoji-picker data-target={target}>
  <button type="button" class="tool" data-emoji-toggle aria-expanded="false">😊 表情</button>

  <div class="emoji-panel" data-emoji-panel hidden>
    {emojis.map((emoji) => <button type="button" data-emoji={emoji} aria-label={emoji}>{emoji}</button>)}
  </div>
</div>

<style>
  /* display: contents 让按钮和面板成为父容器（.editor-bar / .reply-tools）的直接 flex 子项。
     外壳自己不留盒子，否则它的宽度会被内容撑开，面板里的网格就只有一两列。 */
  .emoji {
    display: contents;
  }

  .tool {
    font: inherit;
    font-size: 0.8125rem;
    padding: 4px 12px;
    color: var(--text-soft);
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    cursor: pointer;
  }

  .tool:hover {
    border-color: var(--border-strong);
    color: var(--text);
  }

  .emoji-panel {
    /* 独占一整行：父容器有 flex-wrap，100% 的基准宽度会把它挤到下一行 */
    flex: 1 1 100%;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(42px, 1fr));
    gap: 2px;
    padding: 10px;
    background: var(--bg-sunken);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    /* 表情多了要能滚，否则面板会把整页撑得很长 */
    max-height: 232px;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .emoji-panel[hidden] {
    display: none;
  }

  .emoji-panel button {
    font-size: 1.25rem;
    line-height: 1;
    padding: 7px 0;
    background: none;
    border: 1px solid transparent;
    border-radius: 6px;
    cursor: pointer;
  }

  .emoji-panel button:hover {
    background: var(--bg-elev);
    border-color: var(--border);
  }
</style>

<script>
  for (const picker of document.querySelectorAll<HTMLElement>('[data-emoji-picker]')) {
    if (picker.dataset.wired) continue;
    picker.dataset.wired = '1';

    const textarea = document.getElementById(picker.dataset.target ?? '') as HTMLTextAreaElement | null;
    const panel = picker.querySelector<HTMLElement>('[data-emoji-panel]');
    const toggle = picker.querySelector<HTMLElement>('[data-emoji-toggle]');
    if (!textarea || !panel || !toggle) continue;

    toggle.addEventListener('click', () => {
      panel.toggleAttribute('hidden');
      toggle.setAttribute('aria-expanded', panel.hasAttribute('hidden') ? 'false' : 'true');
    });

    for (const button of picker.querySelectorAll<HTMLElement>('button[data-emoji]')) {
      button.addEventListener('click', () => {
        const emoji = button.dataset.emoji ?? '';
        const start = textarea.selectionStart ?? textarea.value.length;
        const end = textarea.selectionEnd ?? start;

        textarea.value = textarea.value.slice(0, start) + emoji + textarea.value.slice(end);
        textarea.focus();
        textarea.selectionStart = textarea.selectionEnd = start + emoji.length;

        // 手动派发一次 input，字数统计之类的监听器才会跟上
        textarea.dispatchEvent(new Event('input', { bubbles: true }));
      });
    }
  }
</script>
