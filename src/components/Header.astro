---
import ThemeToggle from './ThemeToggle.astro';
import { site } from '../data/site';

const nav = [
  { href: '/', label: '首页' },
  { href: '/projects', label: '项目' },
  { href: '/activities', label: '活动' },
  { href: '/guestbook', label: '留言板' },
];

// 去掉结尾斜杠再比较，/projects/ 和 /projects 都算命中
const current = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => (href === '/' ? current === '/' : current.startsWith(href));
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/">
      <span class="brand-path" aria-hidden="true">~/</span>{site.name}
    </a>

    <nav class="nav" aria-label="主导航">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <ThemeToggle />
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg-sunken);
  }

  .header-inner {
    min-height: var(--header-h);
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-mono); /* taste-skill-ignore: 等宽只用在机器口吻的元信息（导航、时间、计数、命令），是这套设计的一部分 */
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text);
    white-space: nowrap;
    letter-spacing: -0.01em;
  }

  .brand-path {
    color: var(--accent);
  }

  .brand:hover {
    color: var(--accent);
  }

  .nav {
    margin-left: auto;
  }

  .nav ul {
    display: flex;
    align-items: center;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* 44px 高的整块可点区域，指示线用伪元素画在底部 */
  .nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 10px;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--text-soft);
    transition: color var(--dur-2) var(--ease-out);
  }

  .nav a::after {
    content: '';
    position: absolute;
    inset-inline: 10px;
    bottom: 0;
    height: 2px;
    background: transparent;
    transition: background-color var(--dur-2) var(--ease-out);
  }

  .nav a:hover {
    color: var(--text);
  }

  .nav a[aria-current='page'] {
    color: var(--text);
  }

  .nav a[aria-current='page']::after {
    background: var(--accent);
  }

  @media (max-width: 480px) {
    .header-inner {
      gap: 10px;
    }

    .nav a {
      padding-inline: 7px;
      font-size: 0.8125rem;
    }

    .nav a::after {
      inset-inline: 7px;
    }
  }
</style>
