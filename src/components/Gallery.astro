---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  photos: ImageMetadata[];
  /** 图片替代文本前缀，最终会拼上序号 */
  alt?: string;
}

const { photos, alt = '活动照片' } = Astro.props;
---

{
  photos.length > 0 && (
    <ul class="gallery">
      {photos.map((photo, i) => (
        <li>
          <a href={photo.src} target="_blank" rel="noopener" title="查看大图">
            <Image
              src={photo}
              alt={`${alt} ${i + 1}`}
              widths={[320, 640, 1280]}
              sizes="(max-width: 560px) 45vw, 440px"
              loading="lazy"
              decoding="async"
            />
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .gallery {
    display: grid;
    /* auto-fit 而不是 auto-fill：图片少的时候会把空轨道收掉、让图铺开。
       用 auto-fill 时两张图会挤在 168px 的格子里，截图里的字根本看不清。 */
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .gallery a {
    display: block;
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--bg-sunken);
    transition: border-color 0.18s ease, transform 0.18s ease;
  }

  .gallery a:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .gallery :global(img) {
    width: 100%;
    height: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    display: block;
  }
</style>
