---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  photos: ImageMetadata[];
  /** 与 photos 按顺序一一对应的说明，可以少写或不写 */
  captions?: string[];
  /** 图片替代文本前缀，没写说明时用它拼序号 */
  alt?: string;
}

const { photos, captions = [], alt = '活动照片' } = Astro.props;
---

{
  photos.length > 0 && (
    <ul class="gallery">
      {photos.map((photo, i) => (
        <li>
          <a href={photo.src} target="_blank" rel="noopener" title="查看原图">
            <Image
              src={photo}
              alt={captions[i] ?? `${alt} ${i + 1}`}
              widths={[320, 640, 1280]}
              sizes="(max-width: 560px) 90vw, 300px"
              loading="lazy"
              decoding="async"
            />
          </a>
          {captions[i] && <p class="gallery-caption">{captions[i]}</p>}
        </li>
      ))}
    </ul>
  )
}

<style>
  /* 用多列（masonry 效果）而不是等高网格：
     活动照片横竖混在一起时，等高网格会把竖图裁掉一大截，
     而 `columns` 让每张图按自己的比例排，谁都不缺。 */
  .gallery {
    columns: 240px;
    column-gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .gallery li {
    break-inside: avoid;
    margin-bottom: 16px;
  }

  .gallery a {
    display: block;
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--bg-sunken);
    transition: border-color 0.18s ease;
  }

  .gallery a:hover {
    border-color: var(--accent);
  }

  .gallery :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }

  .gallery-caption {
    margin-top: 7px;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--text-muted);
  }
</style>
