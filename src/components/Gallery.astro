---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  photos: ImageMetadata[];
  /** 与 photos 按顺序一一对应的说明，可以少写或不写 */
  captions?: string[];
  /** 图片替代文本前缀，没写说明时用它拼序号 */
  alt?: string;
}

const { photos, captions = [], alt = '活动照片' } = Astro.props;
---

{
  photos.length > 0 && (
    <ul class="gallery">
      {photos.map((photo, i) => (
        <li data-reveal>
          {/* 点开就是原图（和原来一样的逻辑），缩略图统一裁成方形 */}
          <a href={photo.src} target="_blank" rel="noopener" title="查看原图">
            <Image
              src={photo}
              alt={captions[i] ?? `${alt} ${i + 1}`}
              widths={[320, 640, 1280]}
              sizes="(max-width: 560px) 45vw, (max-width: 1040px) 22vw, 200px"
              loading="lazy"
              decoding="async"
            />
          </a>
          {captions[i] && <p class="gallery-caption">{captions[i]}</p>}
        </li>
      ))}
    </ul>
  )
}

<style>
  /* 方形网格：每张图裁成 1:1，横竖混排时排得像照片墙的格子 */
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: clamp(10px, 1.6vw, 16px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .gallery li {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }

  .gallery a {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--bg-sunken);
  }

  .gallery :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 600ms var(--ease-out);
  }

  .gallery a:hover :global(img) {
    transform: scale(1.03);
  }

  .gallery-caption {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--text-soft);
    overflow-wrap: anywhere;
  }
</style>
