---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, summary, href, tags, period } = project.data;
---

<article class="project-card">
  <div class="card-top">
    <h3>{title}</h3>
    {period && <span class="period">{period}</span>}
  </div>

  <p class="summary">{summary}</p>

  {
    tags.length > 0 && (
      <ul class="chips">
        {tags.map((tag) => (
          <li class="chip">{tag}</li>
        ))}
      </ul>
    )
  }

  {
    href && (
      <>
        <span class="go" aria-hidden="true">
          访问<span class="arrow">↗</span>
        </span>
        <a class="stretched" href={href} target="_blank" rel="noopener">
          <span class="sr-only">访问 {title}</span>
        </a>
      </>
    )
  }
</article>

<style>
  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 22px;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease;
    height: 100%;
  }

  /* 有外链时整张卡片可点，hover 有反馈 */
  .project-card:has(.stretched):hover {
    border-color: var(--border-strong);
    transform: translateY(-2px);
    box-shadow: var(--shadow);
  }

  .card-top {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .card-top h3 {
    font-size: 1.0625rem;
  }

  .period {
    margin-left: auto;
    flex: none;
    font-size: 0.75rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .summary {
    font-size: 0.9375rem;
    color: var(--text-soft);
    flex: 1;
  }

  .go {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.8125rem;
    color: var(--accent);
    font-weight: 550;
  }

  .go .arrow {
    font-size: 0.8em;
    opacity: 0.7;
  }

  .stretched {
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  /* 键盘用户也能看到焦点框 */
  .stretched:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>
