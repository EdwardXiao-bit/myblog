---
// 全站点阵：纸面上的点会被鼠标轻轻挤开，松手后带阻尼回到原位。
// 固定成视口大小的一层垫在所有页面内容下面，滚动时用 transform 平移（不重绘），
// 所以长页面也只付一块画布的代价；没有 JS / 减少动效 / 触屏都不做交互，
// 减少动效直接静态画一次。无 JS 时 body 自带同格点的静态点阵兜底。
---

<canvas class="dotfield" aria-hidden="true"></canvas>

<style>
  .dotfield {
    position: fixed;
    inset: 0;
    z-index: 0;
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
    background: var(--bg);
  }
</style>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('canvas.dotfield');
  const ctx = canvas?.getContext('2d');
  if (canvas && ctx) {
    const SPACING = 22;
    const DOT = 1.8;
    const RADIUS = 140;
    const SHIFT = 12;
    const SPRING = 0.18;
    const DAMPING = 0.78;

    // 指针光晕：半径和点被推开的范围一致，光就落在点让出来的空处；
    // 并且先画光、后画点，点压在光上面，点阵的层次不会被光洗掉。
    const AURA = RADIUS;

    type Dot = { ox: number; oy: number; x: number; y: number; vx: number; vy: number };

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const fine = window.matchMedia('(hover: hover) and (pointer: fine)');

    let dots: Dot[] = [];
    let width = 0;
    let height = 0;
    let raf = 0;
    let pointer: { x: number; y: number } | null = null;
    let auraInk: { rgb: string; core: string; mid: string } | null = null;
    let scrolling = false;
    let scrollTimer = 0;

    const ink = () => {
      const value = getComputedStyle(document.documentElement).getPropertyValue('--grid-dot').trim();
      return value || 'rgba(24, 30, 16, 0.16)';
    };

    // 光晕的颜色交给 CSS 令牌，明暗两套主题各自给 rgb 和两级透明度
    const aura = () => {
      if (auraInk) return auraInk;
      const style = getComputedStyle(document.documentElement);
      auraInk = {
        rgb: style.getPropertyValue('--aura-rgb').trim() || '255 255 255',
        core: style.getPropertyValue('--aura-core').trim() || '0.78',
        mid: style.getPropertyValue('--aura-mid').trim() || '0.2',
      };
      return auraInk;
    };

    const build = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = canvas.clientWidth;
      height = canvas.clientHeight;
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      const cols = Math.floor(width / SPACING) + 1;
      const rows = Math.floor(height / SPACING) + 1;
      dots = [];
      for (let row = 0; row < rows; row++) {
        for (let col = 0; col < cols; col++) {
          // 与 body 静态点阵同一个格点：背景点阵的中心在 10 + 22k
          const x = 10 + col * SPACING;
          const y = 10 + row * SPACING;
          dots.push({ ox: x, oy: y, x, y, vx: 0, vy: 0 });
        }
      }
    };

    const paint = () => {
      ctx.fillStyle = ink();
      for (const dot of dots) ctx.fillRect(dot.ox - DOT / 2, dot.oy - DOT / 2, DOT, DOT);
    };

    const draw = () => {
      raf = 0;
      ctx.clearRect(0, 0, width, height);
      ctx.fillStyle = ink();

      const px = pointer?.x ?? 0;
      const py = pointer?.y ?? 0;
      let settled = true;

      // 先铺光，再点墨点：光在纸面，点在纸上，点不会被光洗淡
      // 光不插值，直接落在指针上（要跟手，不要拖影）
      if (pointer) {
        const a = aura();
        const gradient = ctx.createRadialGradient(px, py, 0, px, py, AURA);
        gradient.addColorStop(0, `rgb(${a.rgb} / ${a.core})`);
        gradient.addColorStop(0.55, `rgb(${a.rgb} / ${a.mid})`);
        gradient.addColorStop(1, `rgb(${a.rgb} / 0)`);
        ctx.fillStyle = gradient;
        ctx.fillRect(px - AURA, py - AURA, AURA * 2, AURA * 2);
        ctx.fillStyle = ink();
      }

      for (const dot of dots) {
        let near = false;
        let tx = dot.ox;
        let ty = dot.oy;

        if (pointer) {
          const dx = dot.ox - px;
          const dy = dot.oy - py;
          const dist = Math.hypot(dx, dy);
          if (dist < RADIUS && dist > 0.01) {
            // 被挤开的点朝远离光标的方向让出最多 12px（22px 网格的一半，正好让开一格）
            const push = SHIFT * (1 - dist / RADIUS) ** 2;
            tx = dot.ox + (dx / dist) * push;
            ty = dot.oy + (dy / dist) * push;
            near = true;
          }
        }

        dot.vx = (dot.vx + (tx - dot.x) * SPRING) * DAMPING;
        dot.vy = (dot.vy + (ty - dot.y) * SPRING) * DAMPING;
        dot.x += dot.vx;
        dot.y += dot.vy;

        if (settled && (Math.abs(dot.vx) > 0.02 || Math.abs(dot.vy) > 0.02)) settled = false;

        ctx.globalAlpha = near ? 0.7 : 1;
        ctx.fillRect(dot.x - DOT / 2, dot.y - DOT / 2, DOT, DOT);
      }

      ctx.globalAlpha = 1;
      if (!settled && !scrolling && !document.hidden) raf = requestAnimationFrame(draw);
    };

    const request = () => {
      if (!raf && !scrolling && !document.hidden) raf = requestAnimationFrame(draw);
    };

    const onPointer = (event: PointerEvent) => {
      if (event.pointerType === 'touch') return;
      const rect = canvas.getBoundingClientRect();
      pointer = { x: event.clientX - rect.left, y: event.clientY - rect.top };
      request();
    };

    const onLeave = () => {
      pointer = null;
      request();
    };

    build();

    // 主题切换时点阵的墨色要跟着换：canvas 只在需要时重绘，不跟着 CSS 变。
    const repaint = () => {
      auraInk = null; // 明暗切换后重新读一次光晕令牌
      if (reduce.matches) paint();
      else request();
    };
    new MutationObserver(repaint).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', repaint);

    // 画布固定在视口上，纸面要跟着内容一起走：用 transform 平移一个格距的余数，
    // 只动合成层、不重绘，滚多长都只是同一块画布。
    const syncOffset = () => {
      const offset = window.scrollY % SPACING;
      canvas.style.transform = `translate3d(0, ${-offset}px, 0)`;
    };
    syncOffset();

    if (reduce.matches) {
      paint();
      window.addEventListener('scroll', syncOffset, { passive: true });
    } else {
      window.addEventListener(
        'scroll',
        () => {
          syncOffset();
          // 滚动期间不重绘：把每一帧的预算留给内容本身，停手后再归位
          scrolling = true;
          window.clearTimeout(scrollTimer);
          scrollTimer = window.setTimeout(() => {
            scrolling = false;
            request();
          }, 140);
        },
        { passive: true },
      );

      window.addEventListener(
        'resize',
        () => {
          build();
          syncOffset();
          request();
        },
        { passive: true },
      );

      if (fine.matches) {
        window.addEventListener('pointermove', onPointer, { passive: true });
        document.documentElement.addEventListener('pointerleave', onLeave);
      }

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
          cancelAnimationFrame(raf);
          raf = 0;
        } else {
          request();
        }
      });

      request();
    }
  }
</script>
