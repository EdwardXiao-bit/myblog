---
/**
 * 点赞按钮。留言和回复共用。
 * 无脚本时是普通表单提交（跳回原处），有脚本时原地更新数字、不刷新。
 */
interface Props {
  entry: { id: number; likeCount: number; likedByMe: boolean };
  /** 提交后跳回哪里（无脚本时用） */
  back: string;
}

const { entry, back } = Astro.props;
---

<form class="like" method="post" action="/api/like" data-like>
  <input type="hidden" name="id" value={entry.id} />
  <input type="hidden" name="back" value={back} />
  <button
    type="submit"
    class={entry.likedByMe ? 'liked' : ''}
    aria-pressed={entry.likedByMe ? 'true' : 'false'}
    title={entry.likedByMe ? '再点一下取消' : '点个赞'}
  >
    <span aria-hidden="true">♥</span><!-- taste-skill-ignore: ♥ 是点赞按钮里的图形符号，不是 emoji 图标替代 -->
    <span class="like-count">{entry.likeCount}</span>
  </button>
</form>

<style>
  /* 和 ReactionBar 排在同一行时靠左，像终端里的一条操作 */
  .like {
    display: flex;
    justify-content: flex-start;
    margin-top: 14px;
  }

  .like button {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-mono); /* taste-skill-ignore: 等宽只用在机器口吻的元信息（导航、时间、计数、命令），是这套设计的一部分 */
    font-size: 0.8125rem;
    line-height: 1.4;
    padding: 4px 10px;
    color: var(--text-muted);
    background: transparent;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    cursor: pointer;
    transition:
      color var(--dur-2) var(--ease-out),
      border-color var(--dur-2) var(--ease-out),
      background-color var(--dur-2) var(--ease-out);
  }

  .like button:hover {
    color: var(--accent);
    border-color: var(--line-strong);
    background: var(--bg-sunken);
  }

  .like button.liked {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  .like-count {
    font-variant-numeric: tabular-nums;
  }
</style>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>('form[data-like]')) {
    if (form.dataset.wired) continue;
    form.dataset.wired = '1';

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const button = form.querySelector('button');
      if (!button || button.disabled) return;

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { accept: 'application/json' },
          body: new FormData(form),
        });
        if (!res.ok) throw new Error(String(res.status));

        const data = (await res.json()) as { count: number; liked: boolean };
        const count = button.querySelector('.like-count');
        if (count) count.textContent = String(data.count);
        button.classList.toggle('liked', data.liked);
        button.setAttribute('aria-pressed', data.liked ? 'true' : 'false');
        button.title = data.liked ? '再点一下取消' : '点个赞';
      } catch {
        // 出问题就退回普通表单提交，至少让用户能点上
        form.submit();
      }
    });
  }
</script>
