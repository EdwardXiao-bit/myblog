---
import type { Entry } from '../lib/guestbook';
import { site } from '../data/site';
import { formatDateTime } from '../utils/format';
import ReactionBar from './ReactionBar.astro';

/**
 * 回复列表。留言板和留言管理页共用。
 * 回复本身就是一条 entry，所以配图、点赞、时间这些和留言走的是同一套。
 */
interface Props {
  replies: Entry[];
  /** 管理页里多显示一个删除按钮 */
  canManage?: boolean;
  /** 无脚本点赞时跳回哪里 */
  back: string;
}

const { replies, canManage = false, back } = Astro.props;
---

{
  replies.length > 0 && (
    <ul class="replies">
      {replies.map((reply) => (
        <li class="reply">
          <div class="reply-head">
            <time datetime={reply.createdAt}>{formatDateTime(new Date(reply.createdAt))}</time>
            <span class="who">{site.name}</span>
          </div>

          {reply.body && <p class="reply-body">{reply.body}</p>}

          {reply.attachments.length > 0 && (
            <ul class="shots">
              {reply.attachments.map((image) => (
                <li>
                  <a href={`/uploads/${image.path}`} target="_blank" rel="noopener" title="查看原图">
                    <img src={`/uploads/${image.path}`} alt="回复配图" loading="lazy" decoding="async" />
                  </a>
                </li>
              ))}
            </ul>
          )}

          <div class="reply-foot">
            <ReactionBar entry={reply} back={back} />
            {canManage && (
              <form method="post" action="/api/admin">
                <input type="hidden" name="action" value="unreply" />
                {/* 删的是这一条回复本身，不是父级 */}
                <input type="hidden" name="id" value={reply.id} />
                <button type="submit" class="danger" formnovalidate>
                  删除回复
                </button>
              </form>
            )}
          </div>
        </li>
      ))}
    </ul>
  )
}

<style>
  /* 回复缩进一级，用左侧一条实线表示从属关系，分隔仍是横线 */
  .replies {
    display: grid;
    gap: 0;
    margin: 18px 0 0;
    padding: 0 0 0 16px;
    list-style: none;
    border-left: 2px solid var(--line);
  }

  .reply {
    padding-block: 14px;
  }

  .reply + .reply {
    border-top: 1px solid var(--line); /* taste-skill-ignore: 表单与留言列表的真实分隔，不是装饰性细线 */
  }

  .reply-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
    color: var(--text-muted);
  }

  .reply-head time {
    font-family: var(--font-mono); /* taste-skill-ignore: 等宽只用在机器口吻的元信息（导航、时间、计数、命令），是这套设计的一部分 */
    font-size: 0.8125rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .reply-head .who {
    font-family: var(--font-mono); /* taste-skill-ignore: 等宽只用在机器口吻的元信息（导航、时间、计数、命令），是这套设计的一部分 */
    font-size: 0.8125rem;
    color: var(--text-soft);
  }

  .reply-body {
    margin-top: 8px;
    max-width: 66ch;
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .shots {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(120px, 180px));
    gap: 8px;
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
  }

  .shots a {
    display: block;
    overflow: hidden;
    background: var(--bg-sunken);
  }

  .shots img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 240px;
    object-fit: cover;
    transition: transform 600ms var(--ease-out);
  }

  .shots a:hover img {
    transform: scale(1.03);
  }

  .reply-foot {
    display: flex;
    align-items: center;
    /* 点赞和「删除回复」一起从左边排 */
    justify-content: flex-start;
    gap: 10px;
    flex-wrap: wrap;
  }

  /* ReactionBar 自带的外边距在这里是多余的（这一行本身就有间距） */
  .reply-foot :global(.bar) {
    margin-top: 0;
  }

  .danger {
    font-family: var(--font-mono); /* taste-skill-ignore: 等宽只用在机器口吻的元信息（导航、时间、计数、命令），是这套设计的一部分 */
    font-size: 0.8125rem;
    line-height: 1.4;
    padding: 4px 10px;
    color: var(--text-muted);
    background: transparent;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    cursor: pointer;
    transition:
      color var(--dur-2) var(--ease-out),
      border-color var(--dur-2) var(--ease-out),
      background-color var(--dur-2) var(--ease-out);
  }

  .danger:hover {
    color: var(--text);
    border-color: var(--line-strong);
    background: var(--bg-sunken);
  }
</style>
