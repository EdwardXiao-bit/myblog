---
/**
 * 过去一年的 GitHub 贡献格子。
 * 数据来自 src/data/contributions.json（scripts/fetch-contributions.mjs 生成，Actions 每天更新）。
 * 格子只动 transform / opacity；减少动态偏好下不动。
 */
import data from '../data/contributions.json';

const { weeks, total, longestStreak, from, to } = data;
const flat = weeks.flat();
const days = flat.length;
const active = flat.filter((d) => d.count > 0).length;
const rangeLabel = `${from} 至 ${to}`;
const summary = `过去一年 ${total} 次提交，${active} 天有提交，最长连续 ${longestStreak} 天（${rangeLabel}）`;
const monthOf = (date) => Number(date.slice(5, 7));
const months = [];
let lastLabelWeek = -99;
weeks.forEach((week, index) => {
  const m = monthOf(week[0].date);
  const prev = index > 0 ? monthOf(weeks[index - 1][0].date) : null;
  // 只在月份切换、且离上一个标签至少 5 周时画（否则文字会挤成一坨）
  if (prev !== m && index - lastLabelWeek >= 4) {
    months.push({ month: m, week: index });
    lastLabelWeek = index;
  }
});
---

{weeks.length > 0 && (
  <section class="section contrib-section" aria-labelledby="contrib-h">
    <div class="section-head">
      <h2 id="contrib-h">提交记录</h2>
      <span class="count">{total}</span>
    </div>

    <div class="contrib" data-contrib data-generated={data.generatedAt}>
      <div class="contrib-head">
        <p class="contrib-sum">
          过去一年 <b data-total>{total}</b> 次提交 · <b data-active>{active}</b> 天有提交 · 最长连续
          <b data-streak>{longestStreak}</b> 天
        </p>
        <div class="contrib-legend" aria-hidden="true">
          <span class="contrib-legend-label">少</span>
          {[0, 1, 2, 3, 4].map((level) => <span class={`contrib-cell is-${level}`} />)}
          <span class="contrib-legend-label">多</span>
        </div>
      </div>

      <div class="contrib-scroll">
        <div class="contrib-months" aria-hidden="true">
          {months.map((m) => (
            <span class="contrib-month" style={`grid-column: ${m.week + 1} / span 3`}>
              {m.month} 月
            </span>
          ))}
        </div>

        <div class="contrib-grid" role="img" aria-label={summary}>
          {weeks.map((week) =>
            week.map((d) => (
              <span
                class={`contrib-cell is-${d.level}`}
                style={`grid-row: ${new Date(d.date + 'T00:00:00Z').getUTCDay() + 1}`}
                data-date={d.date}
                data-count={d.count}
              />
            )),
          )}
        </div>
      </div>

      <p class="contrib-tip" data-tip aria-hidden="true"></p>
    </div>
  </section>
)}

<style>
  .contrib {
    position: relative;
    background: var(--bg-elev);
    border-radius: var(--radius-sm);
    padding: clamp(14px, 2.4vw, 22px);
  }

  .contrib-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px 18px;
    margin-bottom: 14px;
  }

  .contrib-sum {
    margin: 0;
    font-size: 1rem;
    color: var(--text-soft);
  }

  .contrib-sum b {
    color: var(--text);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .contrib-legend {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .contrib-legend-label {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .contrib-scroll {
    overflow-x: auto;
    overflow-y: hidden;
    padding-bottom: 2px;
    scrollbar-width: thin;
    scrollbar-color: var(--line-strong) transparent;
  }

  .contrib-months {
    display: grid;
    grid-template-columns: repeat(53, var(--cell));
    gap: var(--gap);
    margin-bottom: 4px;
    min-width: max-content;
  }

  .contrib-month {
    font-size: 0.75rem;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .contrib-grid {
    display: grid;
    grid-template-rows: repeat(7, var(--cell));
    grid-auto-flow: column;
    grid-auto-columns: var(--cell);
    gap: var(--gap);
    min-width: max-content;
    width: max-content;
  }

  .contrib-cell {
    width: var(--cell);
    height: var(--cell);
    border-radius: 1px;
    background: var(--contrib-0);
    transition:
      transform 120ms var(--ease-out),
      opacity 120ms var(--ease-out),
      background-color 120ms linear;
  }

  .contrib-cell.is-1 { background: var(--contrib-1); }
  .contrib-cell.is-2 { background: var(--contrib-2); }
  .contrib-cell.is-3 { background: var(--contrib-3); }
  .contrib-cell.is-4 { background: var(--contrib-4); }

  /* 悬停：当前格放大，其余轻微退后，视线更集中 */
  .contrib-grid:hover .contrib-cell {
    opacity: 0.55;
  }

  .contrib-grid .contrib-cell:hover {
    opacity: 1;
    transform: scale(1.45);
  }

  .contrib-tip {
    position: absolute;
    z-index: 3;
    margin: 0;
    padding: 4px 8px;
    border-radius: var(--radius-sm);
    background: var(--text);
    color: var(--bg);
    font-size: 0.75rem;
    line-height: 1.35;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transform: translate(-50%, calc(-100% - 8px)) scale(0.96);
    transition:
      opacity 120ms var(--ease-out),
      transform 120ms var(--ease-out),
      left 90ms linear,
      top 90ms linear;
  }

  .contrib-tip.is-on {
    opacity: 1;
    transform: translate(-50%, calc(-100% - 8px)) scale(1);
  }

  .contrib-tip b {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .contrib-section {
    --cell: clamp(7px, 1.25vw, 14px);
    --gap: clamp(2px, 0.28vw, 3px);
  }

  @media (max-width: 720px) {
    .contrib-section {
      --cell: 8px;
      --gap: 2px;
    }

    .contrib-months {
      display: none;
    }
  }

  /* 更窄的屏：格子再缩一档，53 周能在一屏里放下，不用横向滑动 */
  @media (max-width: 480px) {
    .contrib-section {
      --cell: 5px;
      --gap: 1px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contrib-cell,
    .contrib-tip {
      transition: none;
    }

    .contrib-grid .contrib-cell:hover {
      transform: none;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-contrib]');
  const tip = root?.querySelector<HTMLElement>('[data-tip]');

  if (root && tip) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const label = (date: string, count: number) => {
      const [, m, d] = date.split('-');
      return `${Number(m)} 月 ${Number(d)} 日 · ${count} 次提交`;
    };

    const show = (cell: HTMLElement) => {
      const box = root.getBoundingClientRect();
      const rect = cell.getBoundingClientRect();
      tip.textContent = label(cell.dataset.date ?? '', Number(cell.dataset.count ?? 0));
      tip.style.left = `${rect.left - box.left + rect.width / 2}px`;
      tip.style.top = `${rect.top - box.top}px`;
      tip.classList.add('is-on');
    };

    const hide = () => tip.classList.remove('is-on');

    // 贡献数据每天由 Actions 提交；页面打开时顺手从仓库 raw 取一次最新版本，
    // 这样不重新部署也能看到当天数据（取不到就用构建时的那份，不报错）。
    const refresh = async () => {
      try {
        // 依次尝试：jsDelivr（国内可达）→ 本站静态副本 → GitHub raw
        const sources = [
          'https://cdn.jsdelivr.net/gh/EdwardXiao-bit/myblog@main/src/data/contributions.json',
          '/contributions.json',
          'https://raw.githubusercontent.com/EdwardXiao-bit/myblog/main/src/data/contributions.json',
        ];
        // 几个源并行取，挑「生成时间最新」的那份；避免 CDN 缓存把新数据覆盖成旧的
        const fetched = await Promise.all(
          sources.map(async (url) => {
            try {
              const res = await fetch(url, { cache: 'no-store' });
              if (!res.ok) return null;
              const json = await res.json();
              return Array.isArray(json?.weeks) && json.generatedAt ? json : null;
            } catch {
              return null;
            }
          }),
        );

        const builtAt = Date.parse(root.dataset.generated ?? '') || 0;
        const latest = fetched
          .filter(Boolean)
          .sort((a, b) => Date.parse(b.generatedAt) - Date.parse(a.generatedAt))[0];
        if (!latest || Date.parse(latest.generatedAt) <= builtAt) return;

        const byDate = new Map(latest.weeks.flat().map((d) => [d.date, d]));
        let total = 0;
        let active = 0;
        let streak = 0;
        let longest = 0;
        for (const cell of root.querySelectorAll<HTMLElement>('.contrib-cell[data-date]')) {
          const next = byDate.get(cell.dataset.date ?? '');
          if (!next) continue;
          cell.dataset.count = String(next.count);
          cell.classList.forEach((name) => {
            if (/^is-\d$/.test(name)) cell.classList.remove(name);
          });
          cell.classList.add(`is-${next.level}`);
          if (next.count > 0) {
            active += 1;
            streak += 1;
            longest = Math.max(longest, streak);
          } else {
            streak = 0;
          }
          total += next.count;
        }

        const set = (sel: string, value: number) => {
          const el = root.querySelector(sel);
          if (el && Number(el.textContent) !== value) el.textContent = String(value);
        };
        set('[data-total]', total);
        set('[data-active]', active);
        set('[data-streak]', longest || latest.longestStreak || 0);
      } catch {
        /* 离线或限流：保留构建时数据 */
      }
    };

    if (!reduce) refresh();

    root.addEventListener('pointerover', (event) => {
      const cell = (event.target as HTMLElement | null)?.closest<HTMLElement>('.contrib-cell');
      if (cell && root.contains(cell)) show(cell);
    });
    root.addEventListener('pointerleave', hide);
    root.addEventListener('focusin', hide);
    if (reduce) tip.classList.remove('is-on');
  }
</script>
